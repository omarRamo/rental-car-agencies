{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HostFiltering": {
    "AllowedHosts": "*.azurewebsites.net;localhost;127.0.0.1",
    "CustomDomains": ""
  },
  "ReverseProxy": {
    "TrustCloudflareHeader": true
  },
  "ConnectionStrings": {
    "Sql": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "CreateContainersOnStartup": true
  },
  "Email": {
    "PickupDirectory": "App_Data/mail"
  },
  "Seed": {
    "Demo": false
  },
  "BackgroundJobs": {
    "RunServer": true,
    "WorkerCount": 4
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Localization": {
    "EnableArabic": false
  },
  "PublicSite": {
    "AgencyName": "CarRental",
    "WhatsAppNumber": "",
    "BaseUrl": ""
  },
  "Observability": {
    "TracesPerSecond": 1.0
  }
}
