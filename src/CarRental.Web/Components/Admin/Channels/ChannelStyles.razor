@* Styles of the channels screens (the back office has no CSS isolation bundle). Contrast of at least 4.5:1; a
   restriction is told by its text, the pattern only helps. Logical properties for the future right-to-left layout. *@
<style>
    .channel-calendar-scroll { overflow-x: auto; border: 1px solid #cbd5e1; border-radius: 0.375rem; background: #ffffff; }
    .channel-calendar-scroll:focus-visible { outline: 2px solid #0b57d0; outline-offset: 2px; }
    .channel-calendar { border-collapse: collapse; min-inline-size: max-content; font-size: 0.8125rem; color: #1b1f24; }
    .channel-calendar th, .channel-calendar td { padding: 0.25rem 0.375rem; border: 1px solid #e5e7eb; text-align: center; white-space: nowrap; }
    .channel-calendar thead th { background: #f8fafc; font-weight: 600; }
    .channel-calendar tbody th { position: sticky; inset-inline-start: 0; background: #ffffff; text-align: start; }
    .channel-calendar abbr { text-decoration: none; }
    .channel-calendar__today { background: #eff6ff !important; }
    .channel-calendar__restricted { background-image: repeating-linear-gradient(45deg, #fff7ed 0, #fff7ed 4px, #ffedd5 4px, #ffedd5 8px); font-weight: 600; }
    .channel-key { padding: 0.75rem 1rem; border: 1px solid #b45309; border-radius: 0.375rem; background: #fffbeb; color: #1b1f24; font-family: monospace; font-size: 0.9375rem; overflow-wrap: anywhere; }
    .channel-figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem 1.5rem; margin: 0; }
    .channel-figures dt { color: #4a5361; font-size: 0.8125rem; }
    .channel-figures dd { margin: 0; font-size: 1.0625rem; font-weight: 600; }
    .channel-scroll { overflow-x: auto; }
    .channel-scroll .mud-table-container { overflow: visible; }
    .channel-scroll:focus-visible { outline: 2px solid #0b57d0; outline-offset: 2px; }
    .channel-excerpt { overflow-wrap: anywhere; font-family: monospace; font-size: 0.8125rem; }
    .channel-number { text-align: end; white-space: nowrap; }
</style>
