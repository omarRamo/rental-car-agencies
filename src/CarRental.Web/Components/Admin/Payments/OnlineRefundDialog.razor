@* Refunds a captured online payment through the gateway (refund.do), with a mandatory reason. Above the approval
   threshold the refund waits for a manager; the amount stays reserved until the gateway confirms it. *@
@inject IOperationRunner Runner
@inject IStringLocalizer<PaymentsResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-3">@L["OnlineRefund.Refundable", PaymentsFormat.Amount(Payment.RefundableAmount)]</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_amount" Label="@L["Field.Amount"]" Min="0m" Max="@Payment.RefundableAmount.Amount" Format="N3"
                                 Adornment="Adornment.End" AdornmentText="TND" Required="true" RequiredError="@Shared["Validation.Required"]" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_reason" Label="@L["Field.RefundReason"]" Lines="2" MaxLength="500" Required="true"
                              RequiredError="@Shared["Validation.Required"]" Immediate="true" />
            </MudItem>
        </MudGrid>
        <FinanceNotice Class="mt-3">@L["OnlineRefund.Hint"]</FinanceNotice>
        @if (_error is not null)
        {
            <FinanceNotice Tone="FinanceTone.Danger" Class="mt-3" Role="alert">@_error</FinanceNotice>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Shared["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))">@L["OnlineRefund.Submit"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private decimal? _amount;
    private string? _reason;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public OnlinePaymentInfo Payment { get; set; } = default!;

    protected override void OnInitialized() => _amount = Payment.RefundableAmount.Amount;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var request = new OnlineRefundRequest(Payment.PaymentId, PaymentsFormat.Value(_amount), _reason ?? string.Empty);
        var result = await Runner.RunAsync<OnlinePaymentAdministration, Result<OnlineRefundOutcome>>((admin, ct) => admin.RefundAsync(request, ct));
        _busy = false;
        if (result.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(result.Value));
        }
        else
        {
            _error = ErrorMessages.For(Shared, result.Error);
        }
    }

    private void Cancel() => Dialog.Cancel();
}
