@* Records a document (first one or renewal: the current one moves to the history) or corrects the current one. *@
@inject IOperationRunner Runner
@inject IStringLocalizer<FleetResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="VehicleDocumentType" @bind-Value="_type" Label="@L["Document.Field.Type"]" Disabled="@(Type is not null)"
                           ToStringFunc="@(t => L[$"DocumentType.{t}"])">
                    @foreach (var type in Enum.GetValues<VehicleDocumentType>())
                    {
                        <MudSelectItem T="VehicleDocumentType" Value="@type">@L[$"DocumentType.{type}"]</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_number" Label="@L["Document.Field.Number"]" Required="true" RequiredError="@Shared["Validation.Required"]"
                              MaxLength="VehicleDocument.NumberMaxLength" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_issuedOn" Label="@L["Document.Field.IssuedOn"]" Editable="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_expiresOn" Label="@L["Document.Field.ExpiresOn"]" Editable="true" Clearable="true"
                               Required="@VehicleCompliance.IsMandatory(_type)" RequiredError="@Shared["Validation.Required"]"
                               HelperText="@L["Document.Field.ExpiresOn.Help"]" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_provider" Label="@L["Document.Field.Provider"]" MaxLength="VehicleDocument.ProviderMaxLength" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_cost" Label="@L["Document.Field.Cost"]" Min="0m" Format="N3" Adornment="Adornment.End" AdornmentText="TND" Clearable="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_notes" Label="@L["Document.Field.Notes"]" Lines="2" MaxLength="VehicleDocument.NotesMaxLength" />
            </MudItem>
        </MudGrid>
        @if (DocumentId is null && Type is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@L["Document.Renew.Hint"]</MudText>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Shared["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">@L["Dialog.Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private VehicleDocumentType _type = VehicleDocumentType.Insurance;
    private string? _number;
    private DateTime? _issuedOn;
    private DateTime? _expiresOn;
    private string? _provider;
    private decimal? _cost;
    private string? _notes;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    /// <summary>The type of the document, fixed for a renewal or a correction.</summary>
    [Parameter]
    public VehicleDocumentType? Type { get; set; }

    /// <summary>The current document to correct; a new document is recorded when null.</summary>
    [Parameter]
    public Guid? DocumentId { get; set; }

    [Parameter]
    public VehicleDocumentItem? Existing { get; set; }

    protected override void OnInitialized()
    {
        _type = Type ?? VehicleDocumentType.Insurance;
        if (Existing is { } document)
        {
            _provider = document.Provider;
            if (DocumentId is not null)
            {
                _number = document.Number;
                _issuedOn = document.IssuedOn?.ToDateTime(TimeOnly.MinValue);
                _expiresOn = document.ExpiresOn?.ToDateTime(TimeOnly.MinValue);
                _cost = document.Cost?.Amount;
                _notes = document.Notes;
            }
            else if (document.ExpiresOn is { } previousExpiry)
            {
                // Renewal: the new period usually starts the day after the previous one.
                _issuedOn = previousExpiry.AddDays(1).ToDateTime(TimeOnly.MinValue);
                _expiresOn = previousExpiry.AddYears(1).ToDateTime(TimeOnly.MinValue);
            }
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var form = new DocumentForm(
            _type,
            _number ?? string.Empty,
            _issuedOn is { } issued ? DateOnly.FromDateTime(issued) : null,
            _expiresOn is { } expires ? DateOnly.FromDateTime(expires) : null,
            _provider,
            _cost,
            _notes);
        var result = DocumentId is { } documentId
            ? await Runner.RunAsync<VehicleService, Result>((service, ct) => service.CorrectDocumentAsync(VehicleId, documentId, form, ct))
            : await Runner.RunAsync<VehicleService, Result<Guid>>((service, ct) => service.RecordDocumentAsync(VehicleId, form, ct));
        _busy = false;
        if (result.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _error = ErrorMessages.For(Shared, result.Error);
        }
    }

    private void Cancel() => Dialog.Cancel();
}
