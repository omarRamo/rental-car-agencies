@* A small status pill. Colours are chosen for a 4.5:1 contrast with white text (WCAG 2.2 AA), which the default
   MudBlazor warning and success palettes do not reach; the text always carries the meaning, the colour only helps. *@

<span class="fleet-badge" style="@Style">@ChildContent</span>

@code {
    [Parameter, EditorRequired]
    public BadgeTone Tone { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Style =>
        $"display:inline-block;padding:0.125rem 0.625rem;border-radius:1rem;font-size:0.8125rem;font-weight:500;line-height:1.5;white-space:nowrap;color:#ffffff;background-color:{Background}";

    private string Background => Tone switch
    {
        BadgeTone.Success => "#15803d",
        BadgeTone.Warning => "#b45309",
        BadgeTone.Danger => "#b91c1c",
        BadgeTone.Info => "#1d4ed8",
        _ => "#4b5563",
    };
}
