@* Justifies a difference of a reconciliation with a reason: the justification is added (never changed), with the user and the instant. *@
@inject IOperationRunner Runner
@inject IStringLocalizer<AccountingResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@L["Justify.Message", L[$"DifferenceKind.{Difference.Kind}"], Difference.Subject, PaymentsFormat.WithSign(Difference.Amount)]</MudText>
        <MudTextField T="string" @bind-Value="_reason" Label="@L["Field.Reason"]" Lines="3" MaxLength="ReconciliationJustification.ReasonMaxLength" Required="true"
                      RequiredError="@Shared["Validation.Required"]" Immediate="true" HelperText="@L["Field.Reason.Help"]" InputId="justification-reason" />
        @if (_error is not null)
        {
            <FinanceNotice Tone="FinanceTone.Danger" Class="mt-3" Role="alert">@_error</FinanceNotice>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Shared["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))"
                   data-testid="justification-save">@L["Justify.Submit"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _reason;
    private string? _error;
    private bool _busy;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid AgencyId { get; set; }

    [Parameter, EditorRequired]
    public AccountingMonth Month { get; set; }

    [Parameter, EditorRequired]
    public DifferenceView Difference { get; set; } = default!;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var (agencyId, month, key, reason) = (AgencyId, Month, Difference.Key, _reason);
        var justified = await Runner.RunAsync<ReconciliationService, Result<Guid>>((service, ct) => service.JustifyAsync(agencyId, month, key, reason, ct));
        _busy = false;
        if (justified.IsSuccess)
        {
            Dialog.Close(DialogResult.Ok(justified.Value));
        }
        else
        {
            _error = ErrorMessages.For(Shared, justified.Error);
        }
    }

    private void Cancel() => Dialog.Cancel();
}
