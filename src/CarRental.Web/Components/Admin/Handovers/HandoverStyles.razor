    .handover-list > li { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 0.75rem 0; border-block-end: 1px solid #e5e7eb; }
    .handover-list > li:last-child { border-block-end: 0; }
