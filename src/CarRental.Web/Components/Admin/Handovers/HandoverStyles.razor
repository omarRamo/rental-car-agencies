    .handover-photo { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; background: #ffffff; }
    .handover-photo--missing { border-style: dashed; border-color: #b45309; }
