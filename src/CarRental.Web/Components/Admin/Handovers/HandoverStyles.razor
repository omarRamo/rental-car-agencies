    .handover-lines { inline-size: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .handover-lines th, .handover-lines td { padding: 0.25rem 0.375rem; border-block-end: 1px solid #e2e8f0; text-align: start; vertical-align: top; }
    .handover-lines .handover-number { text-align: end; white-space: nowrap; }
