    .handover-muted { color: #4a5361; font-size: 0.875rem; }
    .handover-facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0; }
    .handover-facts dt { color: #4a5361; font-size: 0.875rem; }
    .handover-facts dd { margin: 0; }
    .handover-check { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.375rem 0; list-style: none; }
    .handover-checklist { margin: 0; padding: 0; }
