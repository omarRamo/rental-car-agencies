@page "/admin/settings"
@attribute [HasPermission(Permissions.SettingsManage)]
@using CarRental.Web.Components.Admin.Settings
@using CarRental.Web.Resources.Admin.Settings
@inject IStringLocalizer<SettingsAdminResources> L

@* The settings of the agency of the session (ADR-0067): its own values, and the platform values it inherits, which only
   the support changes (here inside an agency, or from the platform settings page). *@
<PageTitle>@L["Settings.Title"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Settings.Title"]</MudText>
<MudText Typo="Typo.body1" Class="mb-2">@L["Settings.Intro"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4">@(_support ? L["Settings.Platform.SupportNote"] : L["Settings.Platform.ReadOnly"])</MudText>

<SettingsBoard AgencyId="@Agency?.Id" CanEditPlatform="_support" />

@code {
    private bool _support;

    /// <summary>The agency of the session (cascaded by the layout).</summary>
    [CascadingParameter]
    public AgencySummary? Agency { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _support = AuthenticationState is not null && (await AuthenticationState).User.IsSupport();
    }
}
