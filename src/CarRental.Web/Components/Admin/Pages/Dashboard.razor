@page "/admin"
@inject IStringLocalizer<AdminResources> L

<PageTitle>@L["Nav.Dashboard"]</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@L["Dashboard.Title"]</MudText>
<AuthorizeView>
    <Authorized Context="auth">
        <MudText Typo="Typo.body1">@L["Dashboard.Welcome", auth.User.GetDisplayName() ?? string.Empty]</MudText>
    </Authorized>
</AuthorizeView>
<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">@L["Dashboard.ComingSoon"]</MudAlert>
<CarRental.Web.Components.Admin.Bookings.BookingsDashboardWidget />
<CarRental.Web.Components.Admin.Handovers.HandoversDashboardWidget />
<CarRental.Web.Components.Admin.Fleet.FleetDashboardWidget />
@* The widget of an optional module only while the module is on for the agency of the session (ADR-0067). *@
@if (CurrentAgency.Offers(Agency, AgencyModules.Reports))
{
    <CarRental.Web.Components.Admin.Reports.ReportsDashboardWidget />
}

@code {
    /// <summary>The agency of the session (cascaded by the layout).</summary>
    [CascadingParameter]
    public AgencySummary? Agency { get; set; }
}
