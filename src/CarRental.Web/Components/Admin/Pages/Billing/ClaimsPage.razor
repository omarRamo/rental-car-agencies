@page "/admin/claims"
@attribute [HasPermission(Permissions.ClaimsManage)]
@attribute [RequiresModule(AgencyModules.ClaimsAndFines)]
@inject IOperationRunner Runner
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<BillingResources> L
@inject IStringLocalizer<SharedResources> Shared

<PageTitle>@L["Claims.Title"]</PageTitle>
<BillingStyles />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1" data-ready="@(RendererInfo.IsInteractive && _agencyId is not null ? "true" : "false")">@L["Claims.Title"]</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAsync" Disabled="@(_agencyId is null)"
               data-testid="claim-new">@L["Claims.Open"]</MudButton>
</MudStack>
<MudText Typo="Typo.body1" Class="mb-4">@L["Claims.Intro"]</MudText>

<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="ClaimStatus?" Value="_status" ValueChanged="StatusChangedAsync" Label="@L["Filter.Status"]" ToStringFunc="@(s => s is { } status ? L[$"ClaimStatus.{status}"] : L["Filter.All"])">
            <MudSelectItem T="ClaimStatus?" Value="@((ClaimStatus?)null)">@L["Filter.All"]</MudSelectItem>
            @foreach (var status in Enum.GetValues<ClaimStatus>())
            {
                <MudSelectItem T="ClaimStatus?" Value="@status">@L[$"ClaimStatus.{status}"]</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

<MudTable @ref="_table" T="ClaimListItem" ServerData="LoadAsync" RowsPerPage="25" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm"
          TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = L["Claims.Title"].Value })">
    <HeaderContent>
        <MudTh>@L["Column.AccidentAt"]</MudTh>
        <MudTh>@L["Column.Vehicle"]</MudTh>
        <MudTh>@L["Column.Booking"]</MudTh>
        <MudTh>@L["Column.Insurer"]</MudTh>
        <MudTh>@L["Column.Status"]</MudTh>
        <MudTh Style="text-align:end">@L["Column.Costs"]</MudTh>
        <MudTh Style="text-align:end">@L["Column.Reimbursements"]</MudTh>
        <MudTh Style="text-align:end">@L["Column.NetCost"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Column.AccidentAt"]"><MudLink Href="@($"/admin/claims/{context.Id:D}")" data-testid="claim-link">@BillingFormat.Instant(context.AccidentAtUtc)</MudLink></MudTd>
        <MudTd DataLabel="@L["Column.Vehicle"]">@context.VehicleLabel</MudTd>
        <MudTd DataLabel="@L["Column.Booking"]">@(context.BookingNumber ?? "—")</MudTd>
        <MudTd DataLabel="@L["Column.Insurer"]">
            @(context.Insurer ?? "—")
            @if (context.InsurerClaimNumber is { } number)
            {
                <MudText Typo="Typo.caption" Class="d-block">@L["Claim.InsurerNumber", number]</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@L["Column.Status"]"><ClaimStatusChip Status="context.Status" /></MudTd>
        <MudTd DataLabel="@L["Column.Costs"]" Class="billing-number">@BillingFormat.Amount(context.TotalCosts)</MudTd>
        <MudTd DataLabel="@L["Column.Reimbursements"]" Class="billing-number">@BillingFormat.Amount(context.TotalReimbursements)</MudTd>
        <MudTd DataLabel="@L["Column.NetCost"]" Class="billing-number">@BillingFormat.Amount(context.NetCost)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@L["Claims.Empty"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <AdminTablePager />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ClaimListItem>? _table;
    private Guid? _agencyId;
    private ClaimStatus? _status;

    /// <summary>The agency of the session (cascaded by the layout): the claims shown are its own (ADR-0067).</summary>
    [CascadingParameter]
    public AgencySummary? Agency { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Agency is { } agency && agency.Id != _agencyId)
        {
            _agencyId = agency.Id;
            await ReloadAsync();
        }
    }

    private async Task<TableData<ClaimListItem>> LoadAsync(TableState state, CancellationToken cancellationToken)
    {
        if (_agencyId is null)
        {
            return new TableData<ClaimListItem> { Items = [], TotalItems = 0 };
        }

        var page = new PageRequest(state.Page + 1, state.PageSize);
        var filter = new ClaimListFilter(_agencyId, _status);
        var result = await Runner.RunAsync<ClaimService, Result<PagedResult<ClaimListItem>>>((service, ct) => service.ListAsync(filter, page, ct), cancellationToken);
        if (result.IsFailure)
        {
            Snackbar.Add(ErrorMessages.For(Shared, result.Error), Severity.Error);
            return new TableData<ClaimListItem> { Items = [], TotalItems = 0 };
        }

        return new TableData<ClaimListItem> { Items = result.Value.Items, TotalItems = result.Value.TotalCount };
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private Task StatusChangedAsync(ClaimStatus? status)
    {
        _status = status;
        return ReloadAsync();
    }

    private async Task OpenAsync()
    {
        if (_agencyId is not { } agencyId)
        {
            return;
        }

        var parameters = new DialogParameters<ClaimFormDialog> { { d => d.AgencyId, agencyId } };
        var dialog = await Dialogs.ShowAsync<ClaimFormDialog>(L["Claims.Open"], parameters, BillingFormat.Dialog(MaxWidth.Medium));
        if (await dialog.Result is { Canceled: false, Data: Guid claimId })
        {
            Snackbar.Add(L["Claims.Opened"], Severity.Success);
            Navigation.NavigateTo($"/admin/claims/{claimId:D}");
        }
    }
}
