@code {
    private const string CustomPeriod = "custom";

    /// <summary>Single series of the charts (validated slot-1 blue on white).</summary>
    private const string SeriesColor = "#2a78d6";

    /// <summary>Ordinal ramp of the pace horizons, light to dark (30, 60, 90 days): validated for colour-vision deficiencies.</summary>
    private static readonly string[] PaceColors = ["#86b6ef", "#2a78d6", "#104281"];

    private static readonly ChartScale FullRatioScale = ChartScale.ForRatio(1m);

    private List<(string Key, string Label)> _months = [];
    private Guid _agencyId;
    private DateOnly _from;
    private DateOnly _to;
    private string _periodKey = string.Empty;
    private DateTime? _customFrom;
    private DateTime? _customTo;
    private ReportDashboard? _report;
    private bool _loading = true;
    private int _loadVersion;
    private string? _error;
    private bool _canReadFleet;
    private bool _canReadBookings;
    private VehicleSort _vehicleSort = VehicleSort.Margin;
    private bool _vehicleSortDescending;
    private IReadOnlyList<VehicleProfitability> _vehicles = [];
    private IReadOnlyList<ChartSeries> _revPav = [];
    private ChartScale _revPavScale = ChartScale.For(0m);
    private IReadOnlyList<ChartSeries> _utilization = [];
    private ChartScale _utilizationScale = FullRatioScale;
    private IReadOnlyList<ChartSeries> _pace = [];
    private ChartScale _paceScale = FullRatioScale;
    private IReadOnlyList<ChartPoint> _channelPoints = [];
    private ChartScale _channelScale = ChartScale.For(0m);
    private IReadOnlyList<ChartPoint> _funnelPoints = [];
    private ChartScale _funnelScale = ChartScale.For(0m);

    /// <summary>The columns the profitability table sorts on.</summary>
    private enum VehicleSort
    {
        Vehicle = 0,
        Category = 1,
        AvailableDays = 2,
        RentedDays = 3,
        Utilization = 4,
        Revenue = 5,
        Margin = 6,
        RevPav = 7,
        HintMargin = 8,
    }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>"true" once the page is interactive and its report loaded (browser tests wait for it).</summary>
    private string ReadyFlag => RendererInfo.IsInteractive && !_loading ? "true" : "false";

    private DateOnly Today => TunisTime.Today(Clock);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        _canReadFleet = user.HasPermission(Permissions.FleetRead);
        _canReadBookings = user.HasPermission(Permissions.BookingsRead);

        // The report is always the one of the agency of the session (ADR-0067).
        _agencyId = (await Current.GetAsync(user))?.Id ?? Guid.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        // The report is computed once, by the interactive render (not by the prerendering as well).
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var fallback = ReportPeriod.DefaultFor(Today);
        (_from, _to) = ReportExport.TryParseDay(From, out var from) && ReportExport.TryParseDay(To, out var to) ? (from, to) : (fallback.From, fallback.To);
        _periodKey = IsMonth(_from, _to) ? MonthKey(_from) : CustomPeriod;
        _customFrom = _from.ToDateTime(TimeOnly.MinValue);
        _customTo = _to.ToDateTime(TimeOnly.MinValue);
        _months = Months();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        if (_agencyId == Guid.Empty)
        {
            (_loading, _report, _error) = (false, null, L["Reports.NoAgency"].Value);
            return;
        }

        _loading = true;
        _error = null;
        var request = new ReportRequest(_agencyId, _from, _to);
        var result = await Runner.RunAsync<ReportQueries, Result<ReportDashboard>>((queries, ct) => queries.GetDashboardAsync(request, ct));
        if (version != _loadVersion)
        {
            return;
        }

        _loading = false;
        if (result.IsFailure)
        {
            (_report, _error) = (null, ErrorMessages.For(Shared, result.Error));
            return;
        }

        _report = result.Value;
        _vehicles = SortedVehicles();
        BuildCharts(_report);
    }

    /// <summary>The current month and the 24 before it, most recent first; a month opened from the address is kept.</summary>
    private List<(string Key, string Label)> Months()
    {
        var current = ReportPeriod.MonthOf(Today).From;
        var months = Enumerable.Range(0, 25).Select(i => current.AddMonths(-i)).ToList();
        if (_periodKey != CustomPeriod && !months.Contains(_from))
        {
            months.Add(_from);
        }

        return [.. months.OrderByDescending(m => m).Select(m => (MonthKey(m), ReportFormat.Month(m)))];
    }

    private static bool IsMonth(DateOnly from, DateOnly to) => from.Day == 1 && to == from.AddMonths(1).AddDays(-1);

    private static string MonthKey(DateOnly day) => day.ToString("yyyy-MM", CultureInfo.InvariantCulture);

    private void Go(DateOnly from, DateOnly to) =>
        Navigation.NavigateTo(string.Create(CultureInfo.InvariantCulture, $"/admin/reports?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}"));

    private void PeriodChanged(string key)
    {
        if (key == CustomPeriod)
        {
            _periodKey = CustomPeriod;
            return;
        }

        if (DateOnly.TryParseExact(key, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            var period = ReportPeriod.MonthOf(month);
            Go(period.From, period.To);
        }
    }

    private void ApplyCustom()
    {
        if (_customFrom is { } from && _customTo is { } to)
        {
            Go(DateOnly.FromDateTime(from), DateOnly.FromDateTime(to));
        }
    }

    private string ExportUrl(ReportTable table) => _report is { } report ? ReportExport.Url(table, report.Period.From, report.Period.To) : "#";

    private string Range(DateOnly from, DateOnly to) => L["Period.Range", ReportFormat.Date(from), ReportFormat.Date(to)];

    private ReportDelta? Points(decimal? current, decimal? previous) => ReportFormat.Points(current, previous, L["Delta.Points"]);

    private IEnumerable<string> Sources(ReportDashboard report)
    {
        if (!report.Sources.CommissionsConnected)
        {
            yield return L["Source.Commissions"];
        }

        if (!report.Sources.InvoicingConnected)
        {
            yield return L["Source.Invoicing"];
        }

        if (!report.Sources.ChargesConnected)
        {
            yield return L["Source.Charges"];
        }
    }

    private async Task RecomputeAsync()
    {
        if (_report is not { } report)
        {
            return;
        }

        var yesterday = Today.AddDays(-1);
        var parameters = new DialogParameters<RecomputeDialog>
        {
            { d => d.AgencyId, report.AgencyId },
            { d => d.AgencyName, report.AgencyName },
            { d => d.From, report.Period.From },
            { d => d.To, report.Period.CoveredTo ?? yesterday },
            { d => d.Yesterday, yesterday },
        };
        var dialog = await Dialogs.ShowAsync<RecomputeDialog>(
            L["Recompute.Title"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: SnapshotRun run })
        {
            Snackbar.Add(L["Recompute.Done", run.Days, run.Rows], Severity.Success);
            await LoadAsync();
        }
    }

    private void SortVehicles(VehicleSort column)
    {
        _vehicleSortDescending = _vehicleSort == column && !_vehicleSortDescending;
        _vehicleSort = column;
        _vehicles = SortedVehicles();
    }

    private IReadOnlyList<VehicleProfitability> SortedVehicles()
    {
        if (_report is not { } report)
        {
            return [];
        }

        IOrderedEnumerable<VehicleProfitability> sorted = _vehicleSort switch
        {
            VehicleSort.Vehicle => Order(report.Vehicles, v => v.PlateNumber),
            VehicleSort.Category => Order(report.Vehicles, v => v.CategoryCode),
            VehicleSort.AvailableDays => Order(report.Vehicles, v => v.Totals.AvailableDays),
            VehicleSort.RentedDays => Order(report.Vehicles, v => v.Totals.RentedDays),
            VehicleSort.Utilization => Order(report.Vehicles, v => v.Totals.Utilization ?? -1m),
            VehicleSort.Revenue => Order(report.Vehicles, v => v.Totals.Revenue.Amount),
            VehicleSort.RevPav => Order(report.Vehicles, v => v.Totals.RevenuePerAvailableDay?.Amount ?? decimal.MinValue),
            VehicleSort.HintMargin => Order(report.Vehicles, v => v.HintDays > 0 ? v.HintMargin.Amount : decimal.MaxValue),
            _ => Order(report.Vehicles, v => v.Totals.Margin.Amount),
        };
        return [.. sorted.ThenBy(v => v.PlateNumber, StringComparer.Ordinal)];
    }

    private IOrderedEnumerable<VehicleProfitability> Order<TKey>(IEnumerable<VehicleProfitability> vehicles, Func<VehicleProfitability, TKey> key)
    {
        var comparer = typeof(TKey) == typeof(string) ? (IComparer<TKey>)StringComparer.Ordinal : Comparer<TKey>.Default;
        return _vehicleSortDescending ? vehicles.OrderByDescending(key, comparer) : vehicles.OrderBy(key, comparer);
    }

    private string? AriaSort(VehicleSort column) =>
        _vehicleSort != column ? null : _vehicleSortDescending ? "descending" : "ascending";

    private RenderFragment SortButton(VehicleSort column, string label) =>
        @<button type="button" class="report-sort" @onclick="() => SortVehicles(column)">
            @label
            <MudIcon Class="report-sort__icon" aria-hidden="true"
                     Icon="@(_vehicleSort != column ? Icons.Material.Filled.UnfoldMore : _vehicleSortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" />
        </button>;

