                        <caption class="visually-hidden">@L["Pace.Title"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@L["Column.Category"]</th>
                                <th scope="col">@L["Column.Horizon"]</th>
                                <th scope="col" class="report-num">@L["Column.SoldDays"]</th>
                                <th scope="col" class="report-num">@L["Column.TentativeDays"]</th>
                                <th scope="col" class="report-num">@L["Column.CapacityDays"]</th>
                                <th scope="col" class="report-num">@L["Column.Occupancy"]</th>
