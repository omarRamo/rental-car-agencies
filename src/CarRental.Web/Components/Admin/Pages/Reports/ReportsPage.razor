                                        <th scope="row">@label</th>
                                        <td>@L["Pace.HorizonValue", horizon.Days]</td>
                                        <td class="report-num">@ReportFormat.Count(horizon.SoldDays)</td>
                                        <td class="report-num">@ReportFormat.Count(horizon.TentativeDays)</td>
                                        <td class="report-num">@ReportFormat.Count(horizon.CapacityDays)</td>
                                        <td class="report-num">@ReportFormat.Percent(horizon.Occupancy)</td>
                                        <td class="report-num">@ReportFormat.Percent(horizon.OccupancyWithTentative)</td>
                                        <td class="report-num">@ReportFormat.Count(horizon.LastYearSoldDays)</td>
