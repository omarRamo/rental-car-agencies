    /// <summary>The groups of the pace: every category together first, then each category.</summary>
    private IEnumerable<(string Label, IReadOnlyList<PaceHorizon> Horizons)> PaceGroups(ReportDashboard report) =>
        [(L["Pace.Total"].Value, report.Pace.Totals), .. report.Pace.Categories.Select(c => (c.CategoryCode, c.Horizons))];

    private void BuildCharts(ReportDashboard report)
    {
        var culture = CultureInfo.CurrentCulture;
        var days = report.Daily;
        _revPav =
        [
            new ChartSeries(
                L["Daily.RevPav.Title"],
                SeriesColor,
                [.. days.Select(d => new ChartPoint(d.Day.ToString("dddd d MMM", culture), d.Totals.RevenuePerAvailableDay?.Amount, ReportFormat.Amount(d.Totals.RevenuePerAvailableDay), ReportFormat.ShortDate(d.Day)))]),
        ];
        _revPavScale = ChartScale.For(days.Select(d => d.Totals.RevenuePerAvailableDay?.Amount ?? 0m).DefaultIfEmpty(0m).Max());
        _utilization =
        [
            new ChartSeries(
                L["Daily.Utilization.Title"],
                SeriesColor,
                [.. days.Select(d => new ChartPoint(d.Day.ToString("dddd d MMM", culture), d.Totals.Utilization, ReportFormat.Percent(d.Totals.Utilization), ReportFormat.ShortDate(d.Day)))]),
        ];
        _utilizationScale = ChartScale.ForRatio(days.Select(d => d.Totals.Utilization ?? 0m).DefaultIfEmpty(0m).Max());

        var channels = report.Channels;
        _channelScale = ChartScale.For(channels.Channels.Select(c => c.Revenue.Amount).DefaultIfEmpty(0m).Max());
        _channelPoints =
        [
            .. channels.Channels.Select(c => new ChartPoint(
                L[$"Channel.{c.Channel}"],
                c.Revenue.Amount,
                L["Channels.Chart.Value", ReportFormat.Amount(c.Revenue), ReportFormat.Percent(channels.ShareOf(c))])),
        ];

        var groups = PaceGroups(report).ToList();
        _pace =
        [
            .. report.Pace.Horizons.Select((days, index) => new ChartSeries(
                L["Pace.HorizonValue", days],
                PaceColors[Math.Min(index, PaceColors.Length - 1)],
                [
                    .. groups.Select(g => new ChartPoint(
                        g.Label,
                        g.Horizons[index].Occupancy,
                        L["Pace.Chart.Value", ReportFormat.Percent(g.Horizons[index].Occupancy), g.Horizons[index].SoldDays, g.Horizons[index].CapacityDays])),
                ])),
        ];
        _paceScale = ChartScale.ForRatio(groups.SelectMany(g => g.Horizons).Select(h => h.Occupancy ?? 0m).DefaultIfEmpty(0m).Max());

        var total = report.Funnel.Total;
        _funnelScale = ChartScale.For(total.Searches);
        _funnelPoints =
        [
            new ChartPoint(L["Column.Searches"], total.Searches, ReportFormat.Count(total.Searches)),
            new ChartPoint(L["Column.Results"], total.Results, L["Funnel.Chart.Value", ReportFormat.Count(total.Results), ReportFormat.Percent(KpiMath.Ratio(total.Results, total.Searches))]),
            new ChartPoint(L["Column.Requests"], total.Requests, L["Funnel.Chart.Value", ReportFormat.Count(total.Requests), ReportFormat.Percent(total.SearchToRequest)]),
            new ChartPoint(L["Column.Confirmed"], total.Confirmed, L["Funnel.Chart.Value", ReportFormat.Count(total.Confirmed), ReportFormat.Percent(total.SearchToConfirmed)]),
        ];
    }

    private string RevPavSummary(ReportDashboard report)
    {
        var best = report.Daily.Where(d => d.Totals.RevenuePerAvailableDay is not null).MaxBy(d => d.Totals.RevenuePerAvailableDay!.Value.Amount);
        return L[
            "Daily.RevPav.Summary",
            report.Daily.Count,
            ReportFormat.Amount(report.Fleet.RevenuePerAvailableDay),
            best is null ? ReportFormat.None : ReportFormat.Amount(best.Totals.RevenuePerAvailableDay),
            best is null ? ReportFormat.None : ReportFormat.Date(best.Day)];
    }

    private string UtilizationSummary(ReportDashboard report)
    {
        var best = report.Daily.Where(d => d.Totals.Utilization is not null).MaxBy(d => d.Totals.Utilization!.Value);
        return L[
            "Daily.Utilization.Summary",
            report.Daily.Count,
            ReportFormat.Percent(report.Fleet.Utilization),
            best is null ? ReportFormat.None : ReportFormat.Percent(best.Totals.Utilization),
            best is null ? ReportFormat.None : ReportFormat.Date(best.Day)];
    }

    private string ChannelsSummary(ReportDashboard report) =>
        L["Channels.Chart.Summary", report.Channels.Channels.Count, Enumerate(_channelPoints.Select(p => (p.Label, p.ValueText)))];

    private string PaceSummary(ReportDashboard report) =>
        L["Pace.Chart.Summary", Enumerate(report.Pace.Totals.Select(h => (L["Pace.HorizonValue", h.Days].Value, ReportFormat.Percent(h.Occupancy))))];

    private string FunnelSummary(ReportDashboard report) =>
        L["Funnel.Chart.Summary", Enumerate(_funnelPoints.Select(p => (p.Label, p.ValueText)))];

    /// <summary>"label: value" pairs in a sentence, with the punctuation of the language.</summary>
    private string Enumerate(IEnumerable<(string Label, string Value)> pairs) =>
        string.Join(L["Chart.Separator"].Value, pairs.Select(p => L["Chart.Pair", p.Label, p.Value].Value));
