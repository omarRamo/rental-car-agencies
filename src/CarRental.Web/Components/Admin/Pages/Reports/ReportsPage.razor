@page "/admin/reports"
@attribute [HasPermission(Permissions.ReportsRead)]
@attribute [RequiresModule(AgencyModules.Reports)]
@* Reports (SPEC §8, ADR-0045 and ADR-0046): for the agency of the session (ADR-0067) and a period (a calendar month by
   default), the fleet indicators of the daily snapshots led by the revenue per available vehicle and per day, the
   profitability of each vehicle, the channels, the booking pace, the conversion, the handling of the requests, the
   cancellations and the cash, each compared with the previous period. Every chart has its data table; every table has
   its Excel export. The period is in the address (from, to), so that a report can be bookmarked or shared. *@
@inject IOperationRunner Runner
@inject CurrentAgency Current
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject IStringLocalizer<ReportsResources> L
@inject IStringLocalizer<SharedResources> Shared

<PageTitle>@L["Reports.Title"]</PageTitle>
<ReportsStyles />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
    <MudText Typo="Typo.h4" HtmlTag="h1" data-ready="@ReadyFlag">@L["Reports.Title"]</MudText>
    @if (_report is { } top)
    {
        <div class="report-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecomputeAsync"
                       Disabled="@(!top.Period.HasElapsedDays)">@L["Recompute.Open"]</MudButton>
            <ExportButton Href="@ExportUrl(ReportTable.All)" Table="@L["Export.AllTables"]" Label="@L["Export.All"]" Variant="Variant.Filled" Size="Size.Medium" />
        </div>
    }
</MudStack>
<MudText Typo="Typo.body2" Class="mb-4">@L["Reports.Intro"]</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <div class="report-toolbar">
        <div class="report-toolbar__field">
            <MudSelect T="string" Value="_periodKey" ValueChanged="PeriodChanged" Label="@L["Filter.Period"]" Variant="Variant.Outlined">
                @foreach (var (key, label) in _months)
                {
                    <MudSelectItem T="string" Value="@key">@label</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@CustomPeriod">@L["Filter.Period.Custom"]</MudSelectItem>
            </MudSelect>
        </div>
        @if (_periodKey == CustomPeriod)
        {
            <div class="report-toolbar__date">
                <MudDatePicker Label="@L["Filter.From"]" @bind-Date="_customFrom" Editable="true" Variant="Variant.Outlined" />
            </div>
            <div class="report-toolbar__date">
                <MudDatePicker Label="@L["Filter.To"]" @bind-Date="_customTo" Editable="true" Variant="Variant.Outlined" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyCustom" Disabled="@(_customFrom is null || _customTo is null)">
                @L["Filter.Apply"]
            </MudButton>
        }
    </div>
</MudPaper>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Loading"]" Class="mb-4" />
}

@if (_report is { } report)
{
    var fleet = report.Fleet;
    var cash = report.Cash;
    var compared = report.Period.PreviousFrom is not null;
    // The fleet indicators compare only with snapshots of the previous period (none: no comparison at all).
    var fleetCompared = report.PreviousCoverage is { ComputedDays: > 0 };
    var previous = fleetCompared ? report.PreviousFleet : null;
    <div style="@(_loading ? "opacity:0.6" : null)" data-testid="report">
        <MudText Typo="Typo.h5" HtmlTag="p" Class="mb-1">@L["Reports.Heading", report.AgencyName, Range(report.Period.From, report.Period.To)]</MudText>
        <ul class="report-notes report-muted mb-2" data-testid="report-notes">
            @if (!report.Period.HasElapsedDays)
            {
                <li>@L["Notes.NoElapsedDay"]</li>
            }
            else if (report.Period.CoveredTo < report.Period.To)
            {
                <li>@L["Notes.Covered", ReportFormat.Date(report.Period.CoveredTo!.Value)]</li>
            }
            @if (report.Period.PreviousFrom is { } previousFrom && report.Period.PreviousTo is { } previousTo)
            {
                <li>@L["Notes.Compared", Range(previousFrom, previousTo)]</li>
                @if (report.PreviousCoverage is { } previousCoverage && !previousCoverage.IsComplete)
                {
                    <li data-testid="previous-coverage">
                        @(previousCoverage.ComputedDays == 0
                            ? L["Notes.PreviousMissing"]
                            : L["Notes.PreviousPartial", previousCoverage.ComputedDays, previousCoverage.ExpectedDays])
                    </li>
                }
            }
            @if (report.Coverage.LastComputedAtUtc is { } computedAt)
            {
                <li>@L["Notes.Computed", ReportFormat.Instant(computedAt)]</li>
            }
            @foreach (var note in Sources(report))
            {
                <li>@note</li>
            }
        </ul>
        @if (report.Period.HasElapsedDays && !report.Coverage.IsComplete)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" data-testid="coverage-warning">
                @L["Coverage.Incomplete", report.Coverage.ComputedDays, report.Coverage.ExpectedDays]
            </MudAlert>
        }

        <ReportSection Id="report-kpis" Title="@L["Kpi.Title"]" Intro="@L["Kpi.Intro"]">
            <dl class="report-kpis">
                <KpiTile Hero="true" TestId="kpi-revpav" Label="@L["Kpi.RevPav"]" Value="@ReportFormat.Amount(fleet.RevenuePerAvailableDay)"
                         Delta="@ReportFormat.Change(fleet.RevenuePerAvailableDay, previous?.RevenuePerAvailableDay)" Compared="fleetCompared"
                         Note="@L["Kpi.RevPav.Note"]" />
                <KpiTile TestId="kpi-utilization" Label="@L["Kpi.Utilization"]" Value="@ReportFormat.Percent(fleet.Utilization)"
                         Delta="@Points(fleet.Utilization, previous?.Utilization)" Compared="fleetCompared"
                         Note="@L["Kpi.Utilization.Note", ReportFormat.Count(fleet.RentedDays), ReportFormat.Count(fleet.AvailableDays)]" />
                <KpiTile TestId="kpi-adr" Label="@L["Kpi.AverageRentedDayPrice"]" Value="@ReportFormat.Amount(fleet.AverageRentedDayPrice)"
                         Delta="@ReportFormat.Change(fleet.AverageRentedDayPrice, previous?.AverageRentedDayPrice)" Compared="fleetCompared" />
                <KpiTile TestId="kpi-revenue" Label="@L["Kpi.Revenue"]" Value="@ReportFormat.Amount(fleet.Revenue)"
                         Delta="@ReportFormat.Change(fleet.Revenue, previous?.Revenue)" Compared="fleetCompared" Note="@L["Kpi.Revenue.Note"]" />
                <KpiTile TestId="kpi-margin" Label="@L["Kpi.Margin"]" Value="@ReportFormat.Amount(fleet.Margin)"
                         Delta="@ReportFormat.Change(fleet.Margin, previous?.Margin)" Compared="fleetCompared"
                         Note="@L["Kpi.Margin.Note", ReportFormat.Amount(fleet.Commission), ReportFormat.Amount(fleet.DirectCosts), ReportFormat.Amount(fleet.Depreciation)]" />
                <KpiTile TestId="kpi-collected" Label="@L["Kpi.CollectedNet"]" Value="@ReportFormat.Amount(cash.CollectedNet)"
                         Delta="@(compared ? ReportFormat.Change(cash.CollectedNet, cash.PreviousCollectedNet) : null)" Compared="compared" />
                <KpiTile TestId="kpi-invoiced" Label="@L["Kpi.Invoiced"]"
                         Value="@(report.Sources.InvoicingConnected ? ReportFormat.Amount(cash.Invoiced.ExclVat) : ReportFormat.None)"
                         Note="@(report.Sources.InvoicingConnected ? L["Kpi.Invoiced.Note", cash.Invoiced.InvoiceCount, cash.Invoiced.CreditNoteCount].Value : L["Kpi.NotConnected"].Value)" />
                <KpiTile TestId="kpi-unpaid" Label="@L["Kpi.Unpaid"]" Value="@ReportFormat.Amount(cash.UnpaidTotal)"
                         Note="@L["Kpi.Unpaid.Note", cash.Unpaid.Count]" />
                <KpiTile TestId="kpi-deposits" Label="@L["Kpi.OpenDeposits"]" Value="@ReportFormat.Amount(cash.OpenDeposits)"
                         Note="@L["Kpi.OpenDeposits.Note", cash.OpenDepositCount]" />
            </dl>
        </ReportSection>

        <ReportSection Id="report-daily" Title="@L["Daily.Title"]" Intro="@L["Daily.Intro"]">
            <Actions>
                <ExportButton Href="@ExportUrl(ReportTable.Daily)" Table="@L["Daily.Title"]" Label="@L["Export.Table"]" />
            </Actions>
            <ChildContent>
                @if (report.Daily.Count == 0)
                {
                    <MudText Typo="Typo.body2">@L["Notes.NoElapsedDay"]</MudText>
                }
                else
                {
                    <div class="report-charts">
                        <ChartFrame Id="chart-revpav" TestId="chart-revpav" Title="@L["Daily.RevPav.Title"]" Caption="@L["Daily.RevPav.Caption"]"
                                    Summary="@RevPavSummary(report)">
                            <ChildContent>
                                <ColumnChart Series="_revPav" Scale="_revPavScale" TickText="@(value => ReportFormat.Tick(value, _revPavScale.Step))" />
                            </ChildContent>
                            <Table>
                                <MudSimpleTable Dense="true" Elevation="0" Class="report-table">
                                    <caption class="visually-hidden">@L["Daily.RevPav.Title"]</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["Column.Day"]</th>
                                            <th scope="col" class="report-num">@L["Column.AvailableDays"]</th>
                                            <th scope="col" class="report-num">@L["Column.Revenue"]</th>
                                            <th scope="col" class="report-num">@L["Column.RevPav"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in report.Daily)
                                        {
                                            <tr>
                                                <th scope="row">@ReportFormat.Date(day.Day)</th>
                                                <td class="report-num">@ReportFormat.Count(day.Totals.AvailableDays)</td>
                                                <td class="report-num">@ReportFormat.Number(day.Totals.Revenue)</td>
                                                <td class="report-num">@ReportFormat.Number(day.Totals.RevenuePerAvailableDay)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th scope="row">@L["Table.Total"]</th>
                                            <td class="report-num">@ReportFormat.Count(fleet.AvailableDays)</td>
                                            <td class="report-num">@ReportFormat.Number(fleet.Revenue)</td>
                                            <td class="report-num">@ReportFormat.Number(fleet.RevenuePerAvailableDay)</td>
                                        </tr>
                                    </tfoot>
                                </MudSimpleTable>
                            </Table>
                        </ChartFrame>
                        <ChartFrame Id="chart-utilization" TestId="chart-utilization" Title="@L["Daily.Utilization.Title"]" Caption="@L["Daily.Utilization.Caption"]"
                                    Summary="@UtilizationSummary(report)">
                            <ChildContent>
                                <ColumnChart Series="_utilization" Scale="_utilizationScale" TickText="@(value => ReportFormat.PercentTick(value, _utilizationScale.Step))" />
                            </ChildContent>
                            <Table>
                                <MudSimpleTable Dense="true" Elevation="0" Class="report-table">
                                    <caption class="visually-hidden">@L["Daily.Utilization.Title"]</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["Column.Day"]</th>
                                            <th scope="col" class="report-num">@L["Column.AvailableDays"]</th>
                                            <th scope="col" class="report-num">@L["Column.RentedDays"]</th>
                                            <th scope="col" class="report-num">@L["Column.Utilization"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var day in report.Daily)
                                        {
                                            <tr>
                                                <th scope="row">@ReportFormat.Date(day.Day)</th>
                                                <td class="report-num">@ReportFormat.Count(day.Totals.AvailableDays)</td>
                                                <td class="report-num">@ReportFormat.Count(day.Totals.RentedDays)</td>
                                                <td class="report-num">@ReportFormat.Percent(day.Totals.Utilization)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th scope="row">@L["Table.Total"]</th>
                                            <td class="report-num">@ReportFormat.Count(fleet.AvailableDays)</td>
                                            <td class="report-num">@ReportFormat.Count(fleet.RentedDays)</td>
                                            <td class="report-num">@ReportFormat.Percent(fleet.Utilization)</td>
                                        </tr>
                                    </tfoot>
                                </MudSimpleTable>
                            </Table>
                        </ChartFrame>
                    </div>
                }
            </ChildContent>
        </ReportSection>

        <ReportSection Id="report-vehicles" Title="@L["Vehicles.Title"]" Intro="@L["Vehicles.Intro", report.SellHintMonths]">
            <Actions>
                <ExportButton Href="@ExportUrl(ReportTable.Vehicles)" Table="@L["Vehicles.Title"]" Label="@L["Export.Table"]" />
            </Actions>
            <ChildContent>
                <TableRegion LabelledBy="report-vehicles-title" TestId="vehicles-table">
                    <MudTable T="VehicleProfitability" Items="_vehicles" RowsPerPage="25" Dense="true" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm"
                              Class="report-table" TableAttributes="@(new Dictionary<string, object> { ["aria-labelledby"] = "report-vehicles-title" })">
                        <HeaderContent>
                            <MudTh aria-sort="@AriaSort(VehicleSort.Vehicle)">@SortButton(VehicleSort.Vehicle, L["Column.Vehicle"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.Category)">@SortButton(VehicleSort.Category, L["Column.Category"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.AvailableDays)" Class="report-num">@SortButton(VehicleSort.AvailableDays, L["Column.AvailableDays"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.RentedDays)" Class="report-num">@SortButton(VehicleSort.RentedDays, L["Column.RentedDays"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.Utilization)" Class="report-num">@SortButton(VehicleSort.Utilization, L["Column.Utilization"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.Revenue)" Class="report-num">@SortButton(VehicleSort.Revenue, L["Column.Revenue"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.Margin)" Class="report-num">@SortButton(VehicleSort.Margin, L["Column.Margin"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.RevPav)" Class="report-num">@SortButton(VehicleSort.RevPav, L["Column.RevPav"])</MudTh>
                            <MudTh aria-sort="@AriaSort(VehicleSort.HintMargin)">@SortButton(VehicleSort.HintMargin, L["Column.HintMargin", report.SellHintMonths])</MudTh>
                            <MudTh Class="report-num">@L["Column.Commission"]</MudTh>
                            <MudTh Class="report-num">@L["Column.DirectCosts"]</MudTh>
                            <MudTh Class="report-num">@L["Column.Depreciation"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Column.Vehicle"]">
                                @if (_canReadFleet)
                                {
                                    <MudLink Href="@($"/admin/fleet/vehicles/{context.VehicleId}")">@context.PlateNumber</MudLink>
                                }
                                else
                                {
                                    <span>@context.PlateNumber</span>
                                }
                                <span class="report-cell-note">@context.VehicleName</span>
                            </MudTd>
                            <MudTd DataLabel="@L["Column.Category"]">@context.CategoryCode</MudTd>
                            <MudTd DataLabel="@L["Column.AvailableDays"]" Class="report-num">@ReportFormat.Count(context.Totals.AvailableDays)</MudTd>
                            <MudTd DataLabel="@L["Column.RentedDays"]" Class="report-num">@ReportFormat.Count(context.Totals.RentedDays)</MudTd>
                            <MudTd DataLabel="@L["Column.Utilization"]" Class="report-num">@ReportFormat.Percent(context.Totals.Utilization)</MudTd>
                            <MudTd DataLabel="@L["Column.Revenue"]" Class="report-num">@ReportFormat.Number(context.Totals.Revenue)</MudTd>
                            <MudTd DataLabel="@L["Column.Margin"]" Class="report-num">@ReportFormat.Number(context.Totals.Margin)</MudTd>
                            <MudTd DataLabel="@L["Column.RevPav"]" Class="report-num">@ReportFormat.Number(context.Totals.RevenuePerAvailableDay)</MudTd>
                            <MudTd DataLabel="@L["Column.HintMargin", report.SellHintMonths]">
                                <span class="report-num-inline">@(context.HintDays > 0 ? ReportFormat.Number(context.HintMargin) : ReportFormat.None)</span>
                                @if (context.SuggestSaleOrReplacement)
                                {
                                    <span class="report-flag" data-testid="sell-hint">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" aria-hidden="true" />@L["Vehicles.Hint"]
                                    </span>
                                }
                                <span class="report-cell-note">@L["Vehicles.HintDays", context.HintDays]</span>
                            </MudTd>
                            <MudTd DataLabel="@L["Column.Commission"]" Class="report-num">@ReportFormat.Number(context.Totals.Commission)</MudTd>
                            <MudTd DataLabel="@L["Column.DirectCosts"]" Class="report-num">@ReportFormat.Number(context.Totals.DirectCosts)</MudTd>
                            <MudTd DataLabel="@L["Column.Depreciation"]" Class="report-num">@ReportFormat.Number(context.Totals.Depreciation)</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>@L["Vehicles.Empty"]</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <AdminTablePager />
                        </PagerContent>
                    </MudTable>
                </TableRegion>
            </ChildContent>
        </ReportSection>

        <ReportSection Id="report-channels" Title="@L["Channels.Title"]" Intro="@L["Channels.Intro"]">
            <Actions>
                <ExportButton Href="@ExportUrl(ReportTable.Channels)" Table="@L["Channels.Title"]" Label="@L["Export.Table"]" />
            </Actions>
            <ChildContent>
                @if (report.Channels.Channels.Count > 0)
                {
                    <div class="report-charts mb-4">
                        <ChartFrame Id="chart-channels" TestId="chart-channels" Title="@L["Channels.Chart.Title"]" Caption="@L["Channels.Chart.Caption"]"
                                    Summary="@ChannelsSummary(report)">
                            <ChildContent>
                                <BarChart Points="_channelPoints" Scale="_channelScale" />
                            </ChildContent>
                            <Table>
                                <MudSimpleTable Dense="true" Elevation="0" Class="report-table">
                                    <caption class="visually-hidden">@L["Channels.Chart.Title"]</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["Column.Channel"]</th>
                                            <th scope="col" class="report-num">@L["Column.Revenue"]</th>
                                            <th scope="col" class="report-num">@L["Column.RevenueShare"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var channel in report.Channels.Channels)
                                        {
                                            <tr>
                                                <th scope="row">@L[$"Channel.{channel.Channel}"]</th>
                                                <td class="report-num">@ReportFormat.Number(channel.Revenue)</td>
                                                <td class="report-num">@ReportFormat.Percent(report.Channels.ShareOf(channel))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </Table>
                        </ChartFrame>
                    </div>
                }
                <TableRegion LabelledBy="report-channels-title" TestId="channels-table">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="1" Class="report-table">
                        <caption class="visually-hidden">@L["Channels.Title"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@L["Column.Channel"]</th>
                                <th scope="col" class="report-num">@L["Column.Bookings"]</th>
                                <th scope="col" class="report-num">@L["Column.RentedDays"]</th>
                                <th scope="col" class="report-num">@L["Column.Revenue"]</th>
                                <th scope="col" class="report-num">@L["Column.RevenueShare"]</th>
                                <th scope="col" class="report-num">@L["Column.Commission"]</th>
                                <th scope="col" class="report-num">@L["Column.NetRevenue"]</th>
                                <th scope="col" class="report-num">@L["Column.AllocatedCosts"]</th>
                                <th scope="col" class="report-num">@L["Column.Margin"]</th>
                                <th scope="col" class="report-num">@L["Column.AverageRentedDayPrice"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (report.Channels.Channels.Count == 0)
                            {
                                <tr><td colspan="10">@L["Channels.Empty"]</td></tr>
                            }
                            @foreach (var channel in report.Channels.Channels)
                            {
                                <tr>
                                    <th scope="row">@L[$"Channel.{channel.Channel}"]</th>
                                    <td class="report-num">@ReportFormat.Count(channel.Bookings)</td>
                                    <td class="report-num">@ReportFormat.Count(channel.RentedDays)</td>
                                    <td class="report-num">@ReportFormat.Number(channel.Revenue)</td>
                                    <td class="report-num">@ReportFormat.Percent(report.Channels.ShareOf(channel))</td>
                                    <td class="report-num">@ReportFormat.Number(channel.Commission)</td>
                                    <td class="report-num">@ReportFormat.Number(channel.NetRevenue)</td>
                                    <td class="report-num">@ReportFormat.Number(channel.AllocatedCosts)</td>
                                    <td class="report-num">@ReportFormat.Number(channel.Margin)</td>
                                    <td class="report-num">@ReportFormat.Number(channel.AverageRentedDayPrice)</td>
                                </tr>
                            }
                            <tr>
                                <th scope="row">@L["Channels.Idle"]</th>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.IdleCosts)</td>
                                <td class="report-num">@ReportFormat.Number(-report.Channels.IdleCosts)</td>
                                <td class="report-num">@ReportFormat.None</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">@L["Table.Total"]</th>
                                <td class="report-num">@ReportFormat.Count(report.Channels.Channels.Sum(c => c.Bookings))</td>
                                <td class="report-num">@ReportFormat.Count(report.Channels.Channels.Sum(c => c.RentedDays))</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.Revenue)</td>
                                <td class="report-num">@ReportFormat.None</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.Commission)</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.Revenue - report.Channels.Commission)</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.Channels.Select(c => c.AllocatedCosts).Sum() + report.Channels.IdleCosts)</td>
                                <td class="report-num">@ReportFormat.Number(report.Channels.Margin)</td>
                                <td class="report-num">@ReportFormat.None</td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                </TableRegion>
                @if (report.Channels.UnattributedRevenue.IsPositive)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">@L["Channels.Unattributed", ReportFormat.Amount(report.Channels.UnattributedRevenue)]</MudText>
                }
            </ChildContent>
        </ReportSection>

        <ReportSection Id="report-pace" Title="@L["Pace.Title"]" Intro="@L["Pace.Intro", ReportFormat.Date(report.Pace.AsOf)]">
            <Actions>
                <ExportButton Href="@ExportUrl(ReportTable.Pace)" Table="@L["Pace.Title"]" Label="@L["Export.Table"]" />
            </Actions>
            <ChildContent>
                <div class="report-charts mb-4">
                    <ChartFrame Id="chart-pace" TestId="chart-pace" Title="@L["Pace.Chart.Title"]" Caption="@L["Pace.Chart.Caption"]" Summary="@PaceSummary(report)">
                        <Legend>
                            <ul class="report-legend">
                                @foreach (var series in _pace)
                                {
                                    <li><span class="report-legend__swatch" style="@($"background:{series.Color}")" aria-hidden="true"></span>@series.Name</li>
                                }
                            </ul>
                        </Legend>
                        <ChildContent>
                            <ColumnChart Series="_pace" Scale="_paceScale" TickText="@(value => ReportFormat.PercentTick(value, _paceScale.Step))" />
                        </ChildContent>
                        <Table>
                            <MudSimpleTable Dense="true" Elevation="0" Class="report-table">
                                <caption class="visually-hidden">@L["Pace.Chart.Title"]</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Column.Category"]</th>
