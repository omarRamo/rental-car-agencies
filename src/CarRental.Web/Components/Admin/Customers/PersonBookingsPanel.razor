@* Rental files of the person. Placeholder until the Bookings package (1E) fills it with the bookings where the person
   is a driver or the payer (IBookingsQueries), ordered by pick-up date. *@
@inject IStringLocalizer<CustomersAdminResources> L

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@L["Bookings.Title"]</MudText>
    <MudText Typo="Typo.body2">@L["Bookings.ComingSoon"]</MudText>
</MudPaper>

@code {
    /// <summary>The person whose rental files are listed (used by the Bookings package).</summary>
    [Parameter, EditorRequired]
    public Guid PersonId { get; set; }
}
