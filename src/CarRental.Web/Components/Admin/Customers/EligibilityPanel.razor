@* Checks the driver eligibility of a person for given pick-up and return dates (Tunis time), with the current settings. *@
@using CarRental.Application.Customers.Administration
@using CarRental.Application.Customers.Contracts
@inject IOperationRunner Runner
@inject TimeProvider Clock
@inject IStringLocalizer<CustomersAdminResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@L["Eligibility.Title"]</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="7">
            <MudDatePicker @bind-Date="_pickupDate" Label="@L["Eligibility.PickupDate"]" Editable="true" />
        </MudItem>
        <MudItem xs="5">
            <MudTimePicker @bind-Time="_pickupTime" Label="@L["Eligibility.PickupTime"]" Editable="true" />
        </MudItem>
        <MudItem xs="7">
            <MudDatePicker @bind-Date="_returnDate" Label="@L["Eligibility.ReturnDate"]" Editable="true" />
        </MudItem>
        <MudItem xs="5">
            <MudTimePicker @bind-Time="_returnTime" Label="@L["Eligibility.ReturnTime"]" Editable="true" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="CheckAsync" Disabled="_busy">
                @L["Eligibility.Check"]
            </MudButton>
        </MudItem>
    </MudGrid>

    <div role="status" aria-live="polite" class="mt-3">
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else if (_result is { IsEligible: true } eligible)
        {
            <MudAlert Severity="Severity.Success">@L["Eligibility.Eligible", eligible.MinimumAge, eligible.MinimumLicenseYears]</MudAlert>
        }
        else if (_result is { } result)
        {
            <MudAlert Severity="Severity.Warning">
                <strong>@L["Eligibility.NotEligible"]</strong>
                <ul class="mt-1 mb-0 ps-4">
                    @foreach (var issue in result.Issues)
                    {
                        <li>@CustomerLabels.Issue(L, issue)</li>
                    }
                </ul>
            </MudAlert>
        }
    </div>
</MudPaper>

@code {
    private DateTime? _pickupDate;
    private TimeSpan? _pickupTime = new(10, 0, 0);
    private DateTime? _returnDate;
    private TimeSpan? _returnTime = new(10, 0, 0);
    private DriverEligibilityInfo? _result;
    private string? _error;
    private bool _busy;

    [Parameter, EditorRequired]
    public Guid PersonId { get; set; }

    protected override void OnInitialized()
    {
        var tomorrow = TunisTime.Today(Clock).AddDays(1);
        _pickupDate = tomorrow.ToDateTime(TimeOnly.MinValue);
        _returnDate = tomorrow.AddDays(3).ToDateTime(TimeOnly.MinValue);
    }

    private async Task CheckAsync()
    {
        _error = null;
        _result = null;
        if (_pickupDate is not { } pickupDate || _returnDate is not { } returnDate)
        {
            _error = Shared["Validation.Required"];
            return;
        }

        _busy = true;
        var pickupAt = TunisTime.FromLocal(DateOnly.FromDateTime(pickupDate), TimeOnly.FromTimeSpan(_pickupTime ?? TimeSpan.Zero));
        var returnAt = TunisTime.FromLocal(DateOnly.FromDateTime(returnDate), TimeOnly.FromTimeSpan(_returnTime ?? TimeSpan.Zero));
        var personId = PersonId;
        var result = await Runner.RunAsync<CustomerAdministrationQueries, Result<DriverEligibilityInfo>>(
            (queries, ct) => queries.CheckEligibilityAsync(personId, pickupAt, returnAt, ct));
        _busy = false;
        if (result.IsSuccess)
        {
            _result = result.Value;
        }
        else
        {
            _error = ErrorMessages.For(Shared, result.Error);
        }
    }
}
