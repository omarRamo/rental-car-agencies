@* A cash session: expected revenue cash and deposit cash, closing count, movements with running balances, and the
   actions allowed to the current user (owner: manual movement and close; cash.manage: also adjustment and lock). *@
@inject IOperationRunner Runner
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject TimeProvider Time
@inject IStringLocalizer<CashResources> L
@inject IStringLocalizer<SharedResources> Shared

<section data-testid="cash-session" data-session-id="@Session.Id" aria-labelledby="@($"session-{Session.Id:N}")">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.h6" HtmlTag="@HeadingTag" id="@($"session-{Session.Id:N}")">
                    @L["Session.Heading", PaymentsFormat.Date(Session.BusinessDate), Session.CashierName]
                </MudText>
                <FinanceBadge Tone="PaymentsFormat.ToneOf(Session.Status)">@L[$"Status.{Session.Status}"]</FinanceBadge>
            </MudStack>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                @if (Session.IsOpen && (IsOwner || CanManage))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapVert" OnClick="AddMovementAsync">@L["Session.ManualMovement"]</MudButton>
                    @if (CanManage)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tune" OnClick="AddAdjustmentAsync">@L["Session.Adjustment"]</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockClock" OnClick="CloseAsync">@L["Session.Close"]</MudButton>
                }
                @if (Session.Status == CashSessionStatusInfo.Closed && CanManage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lock" OnClick="LockAsync">@L["Session.Lock"]</MudButton>
                }
            </MudStack>
        </MudStack>

        @if (Session.IsOpen && Session.BusinessDate < TunisTime.Today(Time))
        {
            <FinanceNotice Tone="FinanceTone.Warning" Class="mb-3">@L["Session.StaleWarning", PaymentsFormat.Date(Session.BusinessDate)]</FinanceNotice>
        }

        <dl class="d-flex flex-wrap gap-6" style="margin:0" data-testid="session-totals">
            <div><dt class="mud-typography mud-typography-caption">@L["Session.OpeningFloat"]</dt><dd style="margin:0" class="mud-typography mud-typography-subtitle1">@PaymentsFormat.Amount(Session.OpeningFloat)</dd></div>
            <div><dt class="mud-typography mud-typography-caption">@L["Session.ExpectedRevenue"]</dt><dd style="margin:0" class="mud-typography mud-typography-h6" data-testid="expected-revenue">@PaymentsFormat.Amount(Session.ExpectedRevenueCash)</dd></div>
            <div><dt class="mud-typography mud-typography-caption">@L["Session.ExpectedDeposit"]</dt><dd style="margin:0" class="mud-typography mud-typography-h6" data-testid="expected-deposit">@PaymentsFormat.Amount(Session.ExpectedDepositCash)</dd></div>
            @if (!Session.IsOpen)
            {
                <div><dt class="mud-typography mud-typography-caption">@L["Session.CountedRevenue"]</dt><dd style="margin:0" class="mud-typography mud-typography-subtitle1">@PaymentsFormat.Amount(Session.CountedRevenueCash)</dd></div>
                <div><dt class="mud-typography mud-typography-caption">@L["Session.RevenueVariance"]</dt><dd style="margin:0" class="mud-typography mud-typography-subtitle1" data-testid="revenue-variance">@PaymentsFormat.WithSign(Session.RevenueVariance)</dd></div>
                <div><dt class="mud-typography mud-typography-caption">@L["Session.CountedDeposit"]</dt><dd style="margin:0" class="mud-typography mud-typography-subtitle1">@PaymentsFormat.Amount(Session.CountedDepositCash)</dd></div>
                <div><dt class="mud-typography mud-typography-caption">@L["Session.DepositVariance"]</dt><dd style="margin:0" class="mud-typography mud-typography-subtitle1">@PaymentsFormat.WithSign(Session.DepositVariance)</dd></div>
            }
        </dl>

        @if (!Session.IsOpen)
        {
            <MudText Typo="Typo.body2" Class="mt-3">@L["Session.ClosedBy", PaymentsFormat.Instant(Session.ClosedAtUtc), Session.ClosedByName ?? "—"]</MudText>
            @if (Session.VarianceJustification is { } justification)
            {
                <MudText Typo="Typo.body2" data-testid="variance-justification">@L["Session.Justification", justification]</MudText>
            }
            @if (Session.LockedAtUtc is { } lockedAt)
            {
                <MudText Typo="Typo.body2">@L["Session.LockedBy", PaymentsFormat.Instant(lockedAt), Session.LockedByName ?? "—"]</MudText>
            }
        }
    </MudPaper>

    <MudTable T="CashMovementInfo" Items="Session.Movements" Dense="true" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm"
              TableAttributes="@(new Dictionary<string, object> { ["aria-label"] = L["Session.Movements"].Value })">
        <HeaderContent>
            <MudTh>@L["Column.Sequence"]</MudTh>
            <MudTh>@L["Column.Time"]</MudTh>
            <MudTh>@L["Column.Kind"]</MudTh>
            <MudTh>@L["Column.Revenue"]</MudTh>
            <MudTh>@L["Column.Deposit"]</MudTh>
            <MudTh>@L["Column.RevenueBalance"]</MudTh>
            <MudTh>@L["Column.DepositBalance"]</MudTh>
            <MudTh>@L["Column.Detail"]</MudTh>
            <MudTh>@L["Column.By"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Column.Sequence"]">@context.Sequence</MudTd>
            <MudTd DataLabel="@L["Column.Time"]">@PaymentsFormat.Instant(context.RecordedAtUtc)</MudTd>
            <MudTd DataLabel="@L["Column.Kind"]">@L[$"Kind.{context.Kind}"]</MudTd>
            <MudTd DataLabel="@L["Column.Revenue"]">@(context.RevenueEffect.IsZero ? "—" : PaymentsFormat.WithSign(context.RevenueEffect))</MudTd>
            <MudTd DataLabel="@L["Column.Deposit"]">@(context.DepositEffect.IsZero ? "—" : PaymentsFormat.WithSign(context.DepositEffect))</MudTd>
            <MudTd DataLabel="@L["Column.RevenueBalance"]">@PaymentsFormat.Amount(context.RevenueBalance)</MudTd>
            <MudTd DataLabel="@L["Column.DepositBalance"]">@PaymentsFormat.Amount(context.DepositBalance)</MudTd>
            <MudTd DataLabel="@L["Column.Detail"]">
                @if (context.Reason is { } reason)
                {
                    @reason
                }
                else if (context.BookingId is { } bookingId)
                {
                    <MudLink Href="@($"/admin/payments/bookings/{bookingId}")" aria-label="@L["Movement.Booking.Label", PaymentsFormat.ShortId(bookingId)]">
                        @L["Movement.Booking", PaymentsFormat.ShortId(bookingId)]
                    </MudLink>
                }
                else
                {
                    @("—")
                }
            </MudTd>
            <MudTd DataLabel="@L["Column.By"]">@(context.RecordedByName ?? "—")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["Session.NoMovement"]</MudText>
        </NoRecordsContent>
    </MudTable>
</section>

@code {
    [Parameter, EditorRequired]
    public CashSessionDetails Session { get; set; } = default!;

    /// <summary>The current user owns the drawer (cash.own on their own session).</summary>
    [Parameter]
    public bool IsOwner { get; set; }

    /// <summary>The current user holds cash.manage (every session, adjustments, lock).</summary>
    [Parameter]
    public bool CanManage { get; set; }

    /// <summary>Tag of the session heading (h2 on the cash page, h2 under the page title elsewhere).</summary>
    [Parameter]
    public string HeadingTag { get; set; } = "h2";

    /// <summary>Raised after every change, so that the host reloads the session.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task AddMovementAsync()
    {
        var parameters = new DialogParameters<ManualMovementDialog> { { d => d.SessionId, Session.Id } };
        var dialog = await Dialogs.ShowAsync<ManualMovementDialog>(L["Manual.Title"], parameters, PaymentsFormat.Dialog());
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Manual.Done"], Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    private async Task AddAdjustmentAsync()
    {
        var parameters = new DialogParameters<AdjustmentDialog> { { d => d.Session, Session } };
        var dialog = await Dialogs.ShowAsync<AdjustmentDialog>(L["Adjustment.Title"], parameters, PaymentsFormat.Dialog());
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Adjustment.Done"], Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    private async Task CloseAsync()
    {
        var parameters = new DialogParameters<CloseSessionDialog> { { d => d.Session, Session } };
        var dialog = await Dialogs.ShowAsync<CloseSessionDialog>(L["Close.Title"], parameters, PaymentsFormat.Dialog());
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Close.Done"], Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    private async Task LockAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Lock.Title"],
            L["Lock.Message", PaymentsFormat.Date(Session.BusinessDate), Session.CashierName],
            yesText: L["Session.Lock"],
            cancelText: Shared["Cancel"]);
        if (confirmed != true)
        {
            return;
        }

        var sessionId = Session.Id;
        var result = await Runner.RunAsync<ICashSessions, Result>((sessions, ct) => sessions.LockAsync(sessionId, ct));
        if (result.IsFailure)
        {
            Snackbar.Add(ErrorMessages.For(Shared, result.Error), Severity.Error);
            return;
        }

        Snackbar.Add(L["Lock.Done"], Severity.Success);
        await OnChanged.InvokeAsync();
    }
}
