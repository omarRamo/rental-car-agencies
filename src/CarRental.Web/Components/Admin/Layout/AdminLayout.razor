@inherits LayoutComponentBase
@inject IStringLocalizer<AdminResources> L
@inject CurrentAgency Current
@inject NavigationManager Navigation

<MudThemeProvider Theme="AdminTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* The interactive router only scrolls to same-page links: once interactive, the skip link moves the focus itself. *@
<a class="skip-link" href="#admin-main" @onclick="SkipToMainAsync" @onclick:preventDefault>@L["SkipToContent"]</a>

<CascadingValue Value="_agency">
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="@L["Menu.Toggle"]" />
            <MudText Typo="Typo.h6" Class="ms-2" data-testid="admin-agency">@(_agency?.Name ?? L["Platform.Title"])</MudText>
            <MudSpacer />
            <CultureMenu />
            <UserMenu />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <AdminNavMenu />
        </MudDrawer>
        <MudMainContent>
            @* data-interactive: "true" once the circuit renders the page (the prerendered HTML says "false"); browser tests
               wait for it before clicking. *@
            <main id="admin-main" tabindex="-1" @ref="_main" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
                @if (_support && _agency is not null)
                {
                    @* The support works in an agency they entered (ADR-0067): said on every page, with the way out. *@
                    <MudAlert Severity="Severity.Info" Dense="true" Square="true" Class="support-banner" role="status">
                        <span>@L["Platform.SupportIn", _agency.Name]</span>
                        <form method="post" action="@PlatformPaths.Leave" class="d-inline ms-4">
                            <AntiforgeryToken />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary">@L["Platform.Leave"]</MudButton>
                        </form>
                    </MudAlert>
                }

                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
                    @* A page starts once the agency of the session is known: it reads it from its first initialization. *@
                    @if (_resolved)
                    {
                        @Body
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" aria-label="@L["Loading"]" />
                    }
                </MudContainer>
            </main>
        </MudMainContent>
    </MudLayout>
</CascadingValue>

@code {
    private bool _drawerOpen = true;
    private ElementReference _main;
    private AgencySummary? _agency;
    private bool _support;
    private bool _resolved;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationState is null)
        {
            _resolved = true;
            return;
        }

        var user = (await AuthenticationState).User;
        _support = user.IsSupport();
        _agency = await Current.GetAsync(user);

        // The back office of an agency needs an agency: the support outside any agency works from the platform pages
        // (the settings and the journal of an agency lead to their platform counterparts).
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (_support && _agency is null && !PlatformPaths.IsPlatformPath(path))
        {
            Navigation.NavigateTo(PlatformPaths.PlatformPageFor(path));
            return;
        }

        _resolved = true;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task SkipToMainAsync() => await _main.FocusAsync();
}
