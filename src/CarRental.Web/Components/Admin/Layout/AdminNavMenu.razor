@* Menu filtered by the permissions of the signed-in user and by the modules of the agency of the session (ADR-0067;
   pages enforce both again). The support outside any agency sees the platform pages only. MudNavMenu renders the nav
   landmark itself: it carries the accessible name (a wrapping nav would make two navigation landmarks). *@
@inject IStringLocalizer<AdminResources> L

<MudNavMenu Class="pt-2" aria-label="@L["Nav.Label"]">
    <AuthorizeView>
        <Authorized Context="auth">
            @foreach (var group in AdminNavigation.Groups)
            {
                if (Agency is null && auth.User.IsSupport() && group.TitleKey != AdminNavigation.PlatformGroupKey)
                {
                    continue;
                }

                var items = group.Items
                    .Where(i => (i.Permission is null || auth.User.HasPermission(i.Permission)) && CurrentAgency.Offers(Agency, i.Module))
                    .ToList();
                if (items.Count == 0)
                {
                    continue;
                }

                <MudNavGroup Title="@L[group.TitleKey]" Icon="@group.Icon" Expanded="true">
                    @foreach (var item in items)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All" ForceLoad="@item.ForceLoad">@L[item.TitleKey]</MudNavLink>
                    }
                </MudNavGroup>
            }
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    /// <summary>The agency of the session (cascaded by the layout), <see langword="null"/> for the support outside any agency.</summary>
    [CascadingParameter]
    public AgencySummary? Agency { get; set; }
}
