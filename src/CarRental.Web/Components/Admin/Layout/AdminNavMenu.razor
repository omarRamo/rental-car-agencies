@* Menu filtered by the permissions of the signed-in user (pages enforce them again). MudNavMenu renders the nav
   landmark itself: it carries the accessible name (a wrapping nav would make two navigation landmarks). *@
@inject IStringLocalizer<AdminResources> L

<MudNavMenu Class="pt-2" aria-label="@L["Nav.Label"]">
    <AuthorizeView>
        <Authorized Context="auth">
            @foreach (var group in AdminNavigation.Groups)
            {
                var items = group.Items.Where(i => i.Permission is null || auth.User.HasPermission(i.Permission)).ToList();
                if (items.Count == 0)
                {
                    continue;
                }

                <MudNavGroup Title="@L[group.TitleKey]" Icon="@group.Icon" Expanded="true">
                    @foreach (var item in items)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All" ForceLoad="@item.ForceLoad">@L[item.TitleKey]</MudNavLink>
                    }
                </MudNavGroup>
            }
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
