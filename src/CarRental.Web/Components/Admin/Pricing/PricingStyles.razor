@* Styles of the pricing screens (rendered once by each pricing page; the back office has no CSS isolation bundle).
   Colours keep a contrast of at least 4.5:1; logical properties for the future right-to-left layout. *@
<style>
    .pricing-notice { display: flex; gap: 0.5rem; align-items: flex-start; padding: 0.5rem 0.75rem; border: 1px solid; border-inline-start-width: 4px; border-radius: 0.375rem; }
    .pricing-notice-icon { flex-shrink: 0; margin-block-start: 0.125rem; color: inherit; }
    .pricing-notice-info { background: #e8f0fe; color: #0b3d91; border-color: #0b57d0; }
    .pricing-notice-success { background: #e6f4ea; color: #14532d; border-color: #15803d; }
    .pricing-notice-warning { background: #fef7e0; color: #713f12; border-color: #b45309; }
    .pricing-notice-error { background: #fce8e6; color: #7f1d1d; border-color: #b91c1c; }

    .editor-row { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
    .editor-row-title { margin-block-end: 0.5rem; padding: 0; font-size: 0.9375rem; font-weight: 600; color: #1b1f24; }

    .mud-button-root.pricing-danger, .mud-icon-button.pricing-danger { color: #b91c1c; }
    .mud-button-outlined.pricing-danger { border-color: #b91c1c; }

    .quote-scroll, .price-grid-scroll { overflow-x: auto; }
    .quote-scroll:focus-visible, .price-grid-scroll:focus-visible { outline: 2px solid #0b57d0; outline-offset: 2px; }
    .quote-scroll .mud-table-container, .price-grid-scroll .mud-table-container { overflow: visible; }
    .quote-lines .quote-number { text-align: end; white-space: nowrap; }
    .quote-lines .quote-label { text-align: start; font-weight: 400; }
    .quote-lines tfoot th, .quote-lines tfoot td { font-weight: 700; }
    .quote-summary { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0; }
    .quote-summary dd { margin: 0; }
    .quote-hint { margin-inline-start: 0.5rem; color: #4a5361; font-size: 0.875rem; }
    .quote-promotions { margin: 0.25rem 0 0; padding-inline-start: 1.25rem; }

    .price-grid th, .price-grid td { min-inline-size: 7.5rem; vertical-align: middle; }
    .price-grid .price-grid-category { min-inline-size: 12rem; text-align: start; }

    .season-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1rem; margin-block-end: 0.75rem; font-size: 0.875rem; }
    .season-swatch { display: inline-block; inline-size: 1rem; block-size: 1rem; margin-inline-end: 0.25rem; border: 1px solid #64748b; border-radius: 0.2rem; vertical-align: middle; }
    .season-months { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 1rem; }
    .season-month { inline-size: 100%; border-collapse: collapse; font-size: 0.8125rem; }
    .season-month caption { padding-block-end: 0.25rem; font-weight: 600; text-align: start; text-transform: capitalize; }
    .season-month th { padding: 0.125rem; font-weight: 500; color: #334155; }
    .season-day { padding: 0.25rem 0; border: 1px solid #ffffff; text-align: center; }
    .season-low { background: #dbeafe; color: #1e3a8a; }
    .season-mid { background: #fef3c7; color: #713f12; }
    .season-high { background: #fee2e2; color: #7f1d1d; }
    .season-event { background: #ede9fe; color: #4c1d95; font-weight: 700; outline: 2px solid #7c3aed; outline-offset: -2px; }
    .season-base { background: #f1f5f9; color: #334155; }
</style>
