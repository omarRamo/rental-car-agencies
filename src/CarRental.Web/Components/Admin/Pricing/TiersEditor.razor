@* Duration tiers: each tier starts on a number of days (the first on day 1) and lasts until the next one; its discount
   applies to the sum of the daily prices. A category can have its own percentage per tier. *@
@using CarRental.Application.Fleet.Contracts
@using CarRental.Application.Pricing.Administration
@using CarRental.Domain.Pricing
@using CarRental.Web.Resources.Admin.Pricing
@inject IOperationRunner Runner
@inject ISnackbar Snackbar
@inject IStringLocalizer<PricingAdminResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudText Typo="Typo.h6" HtmlTag="h2">@L["Tiers.Title"]</MudText>
<MudText Typo="Typo.body2" Class="mb-3">@L["Tiers.Hint"]</MudText>
@foreach (var (row, index) in _tiers.Select((row, index) => (row, index + 1)))
{
    <MudPaper Outlined="true" Class="pa-3 mb-2">
        <fieldset class="editor-row">
        <legend class="editor-row-title">@L["Tiers.Row", index]</legend>
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" @bind-Value="row.MinimumDays" Label="@L["Tiers.From"]" Min="1" Max="365"
                                 Variant="Variant.Outlined" Disabled="!CanEdit" Immediate="true" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="decimal" @bind-Value="row.DiscountPercent" Label="@L["Tiers.Discount"]" Min="0m" Max="99.99m"
                                 Adornment="Adornment.End" AdornmentText="%" ShrinkLabel="true" Variant="Variant.Outlined" Disabled="!CanEdit" Immediate="true" />
            </MudItem>
            <MudItem xs="10" sm="5">
                <MudText Typo="Typo.body2">@RangeText(row)</MudText>
            </MudItem>
            <MudItem xs="2" sm="1" Class="d-flex justify-end">
                @if (CanEdit)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="pricing-danger" aria-label="@L["Tiers.Remove", index]"
                                   OnClick="() => _tiers.Remove(row)" />
                }
            </MudItem>
        </MudGrid>
        </fieldset>
    </MudPaper>
}
@if (_tiers.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">@L["Tiers.Empty"]</MudText>
}

@if (Categories.Count > 0 && _tiers.Count > 0)
{
    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-4">@L["Tiers.Overrides"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">@L["Tiers.Overrides.Hint"]</MudText>
    <div class="price-grid-scroll" tabindex="0" role="region" aria-label="@L["Tiers.Overrides"]">
        <MudSimpleTable Dense="true" Bordered="true" Class="price-grid">
            <caption class="visually-hidden">@L["Tiers.Overrides"]</caption>
            <thead>
                <tr>
                    <th scope="col">@L["Grid.Category"]</th>
                    @foreach (var tier in OrderedTiers())
                    {
                        <th scope="col">@RangeText(tier)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Categories)
                {
                    <tr>
                        <th scope="row" class="price-grid-category">@category.AcrissCode — @category.Name</th>
                        @foreach (var tier in OrderedTiers())
                        {
                            var key = (tier.MinimumDays, category.Id);
                            var id = $"tier-{category.Id:N}-{tier.MinimumDays}";
                            <td>
                                <label class="visually-hidden" for="@id">@L["Tiers.Override.Cell", category.AcrissCode, RangeText(tier)]</label>
                                <MudNumericField T="decimal?" InputId="@id" Value="@_overrides.GetValueOrDefault(key)" ValueChanged="@(value => _overrides[key] = value)"
                                                 HideSpinButtons="true" Placeholder="@tier.DiscountPercent.ToString("0.##", CultureInfo.CurrentCulture)" Adornment="Adornment.End"
                                                 AdornmentText="%" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m" Max="99.99m"
                                                 Disabled="!CanEdit" Immediate="true" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}

<SectionActions CanEdit="CanEdit" Error="@_error" Busy="_busy" AddText="@L["Tiers.Add"]" SaveText="@L["Tiers.Save"]" OnAdd="Add" OnSave="SaveAsync" />

@code {
    private readonly List<TierRow> _tiers = [];
    private readonly Dictionary<(int TierMinimumDays, Guid CategoryId), decimal?> _overrides = [];
    private RatePlanDetail? _source;
    private string? _error;
    private bool _busy;

    [Parameter, EditorRequired]
    public RatePlanDetail Detail { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<VehicleCategoryInfo> Categories { get; set; } = [];

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public EventCallback<RatePlanDetail> OnSaved { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Detail, _source))
        {
            return;
        }

        _source = Detail;
        _tiers.Clear();
        _tiers.AddRange(Detail.Tiers.Select(t => new TierRow { MinimumDays = t.MinimumDays, DiscountPercent = t.DiscountPercent }));
        _overrides.Clear();
        foreach (var discount in Detail.TierCategoryDiscounts)
        {
            _overrides[(discount.TierMinimumDays, discount.CategoryId)] = discount.DiscountPercent;
        }
    }

    private List<TierRow> OrderedTiers() => [.. _tiers.OrderBy(t => t.MinimumDays)];

    private string RangeText(TierRow tier)
    {
        var next = _tiers.Where(t => t.MinimumDays > tier.MinimumDays).Select(t => (int?)t.MinimumDays).Min();
        var discount = tier.DiscountPercent > 0m ? L["Tiers.Discount.Value", PricingDisplay.Percent(tier.DiscountPercent)].Value : L["Tiers.NoDiscount"].Value;
        return next is { } nextStart
            ? L["Tiers.Range", tier.MinimumDays, nextStart - 1, discount]
            : L["Tiers.Range.Open", tier.MinimumDays, discount];
    }

    private void Add()
    {
        var last = _tiers.Count == 0 ? 0 : _tiers.Max(t => t.MinimumDays);
        _tiers.Add(new TierRow { MinimumDays = last == 0 ? 1 : last + 7 });
    }

    private async Task SaveAsync()
    {
        _error = null;
        var tiers = _tiers.Select(t => new DurationTierDefinition(t.MinimumDays, t.DiscountPercent)).ToList();
        var starts = tiers.Select(t => t.MinimumDays).ToHashSet();
        var overrides = _overrides
            .Where(o => o.Value is not null && starts.Contains(o.Key.TierMinimumDays) && Categories.Any(c => c.Id == o.Key.CategoryId))
            .Select(o => new TierCategoryDiscountDefinition(o.Key.TierMinimumDays, o.Key.CategoryId, o.Value!.Value))
            .ToList();
        var (planId, revision) = (Detail.Plan.Id, Detail.Plan.Revision);

        _busy = true;
        var result = await Runner.RunAsync<RatePlanAdministrationService, Result<RatePlanDetail>>(
            (service, ct) => service.UpdateTiersAsync(planId, revision, tiers, overrides, ct));
        _busy = false;
        if (result.IsFailure)
        {
            _error = ErrorMessages.For(Shared, result.Error);
            return;
        }

        // Normal (dark) snackbars keep a 4.5:1 contrast; the default success colour does not.
        Snackbar.Add(L["Editor.Saved"], Severity.Normal);
        await OnSaved.InvokeAsync(result.Value);
    }
}
