@* The price grid: daily prices TTC per category (rows) and period (base price, season levels, events). An empty season
   or event cell inherits the next level (event, then season level, then base price). *@
@using CarRental.Application.Fleet.Contracts
@using CarRental.Application.Pricing.Administration
@using CarRental.Domain.Pricing
@using CarRental.Web.Resources.Admin.Pricing
@inject IOperationRunner Runner
@inject ISnackbar Snackbar
@inject IStringLocalizer<PricingAdminResources> L
@inject IStringLocalizer<SharedResources> Shared

<MudText Typo="Typo.h6" HtmlTag="h2">@L["Grid.Title"]</MudText>
<MudText Typo="Typo.body2" Class="mb-3">@L["Grid.Hint"]</MudText>

<div class="price-grid-scroll" tabindex="0" role="region" aria-label="@L["Grid.Title"]">
    <MudSimpleTable Dense="true" Bordered="true" Class="price-grid">
        <caption class="visually-hidden">@L["Grid.Title"]</caption>
        <thead>
            <tr>
                <th scope="col">@L["Grid.Category"]</th>
                @foreach (var column in _columns)
                {
                    <th scope="col">@column.Title</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var category in _categories)
            {
                <tr>
                    <th scope="row" class="price-grid-category">@category.Label</th>
                    @foreach (var column in _columns)
                    {
                        var id = $"price-{category.Id:N}-{(int)column.Key.Kind}-{column.Key.EventId:N}";
                        <td>
                            <label class="visually-hidden" for="@id">@L["Grid.Cell", category.Label, column.Title]</label>
                            <MudNumericField T="decimal?" InputId="@id" Value="@_cells.GetValueOrDefault((category.Id, column.Key))"
                                             ValueChanged="@(value => _cells[(category.Id, column.Key)] = value)"
                                             HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0m"
                                             Disabled="!CanEdit" Immediate="true" />
                        </td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</div>
@if (_categories.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mt-2">@L["Grid.NoCategory"]</MudText>
}
<SectionActions CanEdit="CanEdit" Error="@_error" Busy="_busy" SaveText="@L["Grid.Save"]" OnSave="SaveAsync" />

@code {
    private readonly Dictionary<(Guid CategoryId, RatePeriodKey Period), decimal?> _cells = [];
    private List<GridColumn> _columns = [];
    private List<GridCategory> _categories = [];
    private RatePlanDetail? _source;
    private string? _error;
    private bool _busy;

    [Parameter, EditorRequired]
    public RatePlanDetail Detail { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<VehicleCategoryInfo> Categories { get; set; } = [];

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter]
    public EventCallback<RatePlanDetail> OnSaved { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Detail, _source))
        {
            return;
        }

        _source = Detail;
        _columns =
        [
            new(RatePeriodKey.Base, L["Period.Base"]),
            new(RatePeriodKey.ForSeason(SeasonLevel.Low), L["Level.Low"]),
            new(RatePeriodKey.ForSeason(SeasonLevel.Mid), L["Level.Mid"]),
            new(RatePeriodKey.ForSeason(SeasonLevel.High), L["Level.High"]),
            .. Detail.Events.Where(e => e.Id is not null).Select(e => new GridColumn(
                RatePeriodKey.ForEvent(e.Id!.Value),
                $"{e.Name} ({PricingDisplay.Date(e.StartDate)})")),
        ];

        var known = Categories.ToDictionary(c => c.Id);
        _categories =
        [
            .. Categories.Select(c => new GridCategory(c.Id, $"{c.AcrissCode} — {c.Name}")),
            .. Detail.Prices.Select(p => p.CategoryId).Distinct().Where(id => !known.ContainsKey(id))
                .Select(id => new GridCategory(id, L["Grid.UnknownCategory", id])),
        ];

        _cells.Clear();
        foreach (var price in Detail.Prices)
        {
            _cells[(price.CategoryId, price.Period)] = price.DailyPrice.Amount;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        var definitions = new List<CategoryPriceDefinition>();
        foreach (var ((categoryId, period), value) in _cells)
        {
            if (value is not { } amount)
            {
                continue;
            }

            var price = EditorValues.Amount(amount);
            if (price.IsFailure)
            {
                _error = ErrorMessages.For(Shared, price.Error);
                return;
            }

            definitions.Add(new CategoryPriceDefinition(categoryId, period, price.Value));
        }

        var (planId, revision) = (Detail.Plan.Id, Detail.Plan.Revision);
        _busy = true;
        var result = await Runner.RunAsync<RatePlanAdministrationService, Result<RatePlanDetail>>(
            (service, ct) => service.UpdatePricesAsync(planId, revision, definitions, ct));
        _busy = false;
        if (result.IsFailure)
        {
            _error = ErrorMessages.For(Shared, result.Error);
            return;
        }

        // Normal (dark) snackbars keep a 4.5:1 contrast; the default success colour does not.
        Snackbar.Add(L["Editor.Saved"], Severity.Normal);
        await OnSaved.InvokeAsync(result.Value);
    }

    private sealed record GridColumn(RatePeriodKey Key, string Title);

    private sealed record GridCategory(Guid Id, string Label);
}
