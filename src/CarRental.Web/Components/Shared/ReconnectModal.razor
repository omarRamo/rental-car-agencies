@* Back office only: shown by blazor.web.js when the interactive connection drops (adapted from the .NET 10 template). *@
@inject IStringLocalizer<SharedResources> L

<script type="module" src="@Assets["Components/Shared/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <p class="components-reconnect-first-attempt-visible">@L["Reconnect.Rejoining"]</p>
        <p class="components-reconnect-repeated-attempt-visible">@L["Reconnect.Retrying"] <span id="components-seconds-to-next-attempt"></span></p>
        <p class="components-reconnect-failed-visible">@L["Reconnect.Failed"]</p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">@L["Reconnect.Retry"]</button>
        <p class="components-pause-visible">@L["Reconnect.Paused"]</p>
        <p class="components-resume-failed-visible">@L["Reconnect.ResumeFailed"]</p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">@L["Reconnect.Resume"]</button>
    </div>
</dialog>
