@* A page the user may not open: signed-in users see an access denied message (HTTP requests are handled earlier by the
   authorization middleware). An interactive circuit that lost its authentication (session revalidation: locked account,
   changed password, revoked permission) reloads the page over HTTP, where the cookie is validated again: the user keeps
   working with the current claims, or is sent to the login page or the access denied page. *@
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

@if (_authenticated)
{
    <section class="access-denied" role="alert">
        <h1>@L["AccessDenied.Title"]</h1>
        <p>@L["AccessDenied.Message"]</p>
    </section>
}

@code {
    private bool _authenticated;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = AuthenticationState is null ? null : await AuthenticationState;
        _authenticated = state?.User.Identity?.IsAuthenticated == true;
        if (_authenticated)
        {
            return;
        }

        if (RendererInfo.IsInteractive)
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        else
        {
            var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"account/login?ReturnUrl={Uri.EscapeDataString("/" + returnUrl)}", forceLoad: true);
        }
    }
}
