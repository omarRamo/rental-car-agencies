@* Same page in each enabled culture: the culture prefix and the localized slug are replaced (/fr/reserver?… →
   /en/book?…), the query string is kept. *@
@inject NavigationManager Navigation
@inject CultureCatalog Cultures

<ul class="language-switcher">
    @foreach (var culture in Cultures.Enabled)
    {
        var isCurrent = string.Equals(culture, _current, StringComparison.OrdinalIgnoreCase);
        <li>
            @if (isCurrent)
            {
                <span class="language-switcher__current" aria-current="true" lang="@culture">@CultureCatalog.NativeName(culture)</span>
            }
            else
            {
                <a href="@PublicRoutes.Localize(_relative, culture)" hreflang="@culture" lang="@culture">@CultureCatalog.NativeName(culture)</a>
            }
        </li>
    }
</ul>

@code {
    private string _current = CultureCatalog.Default;
    private string _relative = "/";

    protected override void OnParametersSet()
    {
        _current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
    }
}
