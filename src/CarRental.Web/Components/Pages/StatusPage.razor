@page "/status/{StatusCode:int}"
@layout Public.Layout.PublicLayout
@attribute [ExcludeFromInteractiveRouting]
@inject IStringLocalizer<SharedResources> L

<PageTitle>@Title</PageTitle>

<section class="status-page">
    <h1>@Title</h1>
    <p>@Message</p>
    <p><a href="@HomePath">@L["NotFound.Home"]</a></p>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The home page of the site of the address (ADR-0067), else the page of the platform.</summary>
    private string HomePath => HttpContext is not null && Public.Site.PublicSiteAgency.SiteOf(HttpContext) is { } site
        ? Public.PublicRoutes.PathFor(site.Slug, Public.PublicPage.Home, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
        : "/";

    [Parameter]
    public int StatusCode { get; set; }

    private string Title => StatusCode switch
    {
        404 => L["NotFound.Title"],
        403 => L["AccessDenied.Title"],
        _ => L["Status.Title", StatusCode],
    };

    private string Message => StatusCode switch
    {
        404 => L["NotFound.Message"],
        403 => L["AccessDenied.Message"],
        _ => L["Status.Message"],
    };
}
