@page "/not-found"
@layout Public.Layout.PublicLayout
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NotFound.Title"]</PageTitle>

<section class="status-page">
    <h1>@L["NotFound.Title"]</h1>
    <p>@L["NotFound.Message"]</p>
    <p><a href="@HomePath">@L["NotFound.Home"]</a></p>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The home page of the site of the address (ADR-0067), else the page of the platform.</summary>
    private string HomePath => HttpContext is not null && Public.Site.PublicSiteAgency.SiteOf(HttpContext) is { } site
        ? Public.PublicRoutes.PathFor(site.Slug, Public.PublicPage.Home, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
        : "/";
}
