@* Inline message, or the one-shot status message left by a redirect (IdentityRedirectManager.RedirectToWithStatus). *@
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    <div class="alert @(IsError ? "alert--error" : "alert--success")" role="@(IsError ? "alert" : "status")">@DisplayMessage</div>
}

@code {
    private string? _messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool IsError { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? _messageFromCookie;

    protected override void OnInitialized()
    {
        _messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];
        if (_messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
