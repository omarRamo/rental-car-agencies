@page "/account/reset-password-confirmation"
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["ResetConfirmation.Title"]</PageTitle>

<div class="account">
    <div class="card">
        <h1>@L["ResetConfirmation.Title"]</h1>
        <p role="status">@L["ResetConfirmation.Message"]</p>
        <p><a class="button" href="account/login">@L["ResetConfirmation.Login"]</a></p>
    </div>
</div>
