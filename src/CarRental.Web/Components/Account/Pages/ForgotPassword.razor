@page "/account/forgot-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject AppUrls Urls
@inject IAuditTrail AuditTrail
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["Forgot.Title"]</PageTitle>

<div class="account">
    <div class="card">
        <h1>@L["Forgot.Title"]</h1>
        <p>@L["Forgot.Intro"]</p>
        <EditForm Model="Input" method="post" OnSubmit="SendAsync" FormName="forgot-password" novalidate>
            <div class="form-field">
                <label for="email">@L["Field.Email"]</label>
                <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true"
                           aria-invalid="@(_emailError is null ? null : "true")" aria-describedby="@(_emailError is null ? null : "email-error")" />
                <FieldError Id="email-error" Message="@_emailError" />
            </div>
            <button type="submit" class="button button--block">@L["Forgot.Submit"]</button>
        </EditForm>
        <p><a href="account/login">@L["BackToLogin"]</a></p>
    </div>
</div>

@code {
    private string? _emailError;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        var email = Input.Email?.Trim() ?? string.Empty;
        if (email.Length == 0)
        {
            _emailError = L["Validation.Required"];
            return;
        }

        var user = await UserManager.FindByEmailAsync(email);
        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var link = Urls.Absolute("account/reset-password", new Dictionary<string, string?>
            {
                ["code"] = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token)),
            });
            await EmailSender.SendPasswordResetLinkAsync(user, email, link);
            await AuditTrail.RecordAsync(new AuditEvent(AuditActions.PasswordResetRequested) { EntityType = "User", EntityId = user.Id.ToString() });
        }

        // Same answer whether the account exists or not.
        RedirectManager.RedirectTo("account/forgot-password-confirmation");
    }

    private sealed class InputModel
    {
        public string? Email { get; set; }
    }
}
