@page "/account/reset-password"
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<ApplicationUser> UserManager
@inject IAuditTrail AuditTrail
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["Reset.Title"]</PageTitle>

<div class="account">
    <div class="card">
        <h1>@L["Reset.Title"]</h1>
        @if (Invitation)
        {
            <p>@L["Reset.InvitationIntro"]</p>
        }
        <p class="field-hint">@L["Reset.Rules"]</p>
        <StatusMessage Message="@_message" IsError="true" />
        <EditForm Model="Input" method="post" OnSubmit="ResetAsync" FormName="reset-password" novalidate>
            <input type="hidden" name="Input.Code" value="@Input.Code" />
            <div class="form-field">
                <label for="email">@L["Field.Email"]</label>
                <InputText id="email" type="email" @bind-Value="Input.Email" autocomplete="username" aria-required="true"
                           aria-invalid="@(_emailError is null ? null : "true")" aria-describedby="@(_emailError is null ? null : "email-error")" />
                <FieldError Id="email-error" Message="@_emailError" />
            </div>
            <div class="form-field">
                <label for="password">@L["Reset.Password"]</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password" aria-required="true"
                           aria-invalid="@(_passwordError is null ? null : "true")" aria-describedby="@(_passwordError is null ? null : "password-error")" />
                <FieldError Id="password-error" Message="@_passwordError" />
            </div>
            <div class="form-field">
                <label for="confirm">@L["Reset.Confirm"]</label>
                <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true"
                           aria-invalid="@(_confirmError is null ? null : "true")" aria-describedby="@(_confirmError is null ? null : "confirm-error")" />
                <FieldError Id="confirm-error" Message="@_confirmError" />
            </div>
            <button type="submit" class="button button--block">@L["Reset.Submit"]</button>
        </EditForm>
    </div>
</div>

@code {
    private string? _message;
    private string? _emailError;
    private string? _passwordError;
    private string? _confirmError;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private bool Invitation { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
        if (Input.Code is null)
        {
            if (Code is null)
            {
                RedirectManager.RedirectTo("account/invalid-password-reset");
                return;
            }

            try
            {
                Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            }
            catch (FormatException)
            {
                RedirectManager.RedirectTo("account/invalid-password-reset");
            }
        }
    }

    private async Task ResetAsync()
    {
        var email = Input.Email?.Trim() ?? string.Empty;
        _emailError = email.Length == 0 ? L["Validation.Required"].Value : null;
        _passwordError = string.IsNullOrEmpty(Input.Password) ? L["Validation.Required"].Value : null;
        _confirmError = Input.Password != Input.ConfirmPassword ? L["Validation.PasswordsDiffer"].Value : null;
        if (_emailError is not null || _passwordError is not null || _confirmError is not null || Input.Code is null)
        {
            return;
        }

        var user = await UserManager.FindByEmailAsync(email);
        if (user is null)
        {
            // Do not reveal whether the account exists.
            RedirectManager.RedirectTo("account/reset-password-confirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            await AuditTrail.RecordAsync(new AuditEvent(AuditActions.PasswordReset)
            {
                EntityType = "User",
                EntityId = user.Id.ToString(),
                Details = Invitation ? "invitation" : null,
            });
            RedirectManager.RedirectTo("account/reset-password-confirmation");
            return;
        }

        _message = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        public string? Email { get; set; }

        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;

        public string? Code { get; set; }
    }
}
