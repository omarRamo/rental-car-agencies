@page "/account/manage/change-password"
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject SignInRecorder Recorder
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["ChangePassword.Title"]</PageTitle>

<h2>@L["ChangePassword.Title"]</h2>
<StatusMessage Message="@_message" IsError="true" />
<p class="field-hint">@L["Reset.Rules"]</p>
<EditForm Model="Input" method="post" OnSubmit="ChangeAsync" FormName="change-password" novalidate>
    <div class="form-field">
        <label for="current">@L["ChangePassword.Current"]</label>
        <InputText id="current" type="password" @bind-Value="Input.OldPassword" autocomplete="current-password" aria-required="true"
                   aria-invalid="@(_oldError is null ? null : "true")" aria-describedby="@(_oldError is null ? null : "current-error")" />
        <FieldError Id="current-error" Message="@_oldError" />
    </div>
    <div class="form-field">
        <label for="new">@L["ChangePassword.New"]</label>
        <InputText id="new" type="password" @bind-Value="Input.NewPassword" autocomplete="new-password" aria-required="true"
                   aria-invalid="@(_newError is null ? null : "true")" aria-describedby="@(_newError is null ? null : "new-error")" />
        <FieldError Id="new-error" Message="@_newError" />
    </div>
    <div class="form-field">
        <label for="confirm">@L["ChangePassword.Confirm"]</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" aria-required="true"
                   aria-invalid="@(_confirmError is null ? null : "true")" aria-describedby="@(_confirmError is null ? null : "confirm-error")" />
        <FieldError Id="confirm-error" Message="@_confirmError" />
    </div>
    <button type="submit" class="button">@L["ChangePassword.Submit"]</button>
</EditForm>

@code {
    private string? _message;
    private string? _oldError;
    private string? _newError;
    private string? _confirmError;
    private ApplicationUser? _user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _user = await UserManager.GetUserAsync(HttpContext.User);
        if (_user is null)
        {
            RedirectManager.RedirectToInvalidUser(HttpContext);
        }
    }

    private async Task ChangeAsync()
    {
        if (_user is null)
        {
            RedirectManager.RedirectToInvalidUser(HttpContext);
            return;
        }

        _oldError = string.IsNullOrEmpty(Input.OldPassword) ? L["Validation.Required"].Value : null;
        _newError = string.IsNullOrEmpty(Input.NewPassword) ? L["Validation.Required"].Value : null;
        _confirmError = Input.NewPassword != Input.ConfirmPassword ? L["Validation.PasswordsDiffer"].Value : null;
        if (_oldError is not null || _newError is not null || _confirmError is not null)
        {
            return;
        }

        var result = await UserManager.ChangePasswordAsync(_user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            _message = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Keeps the current authentication method (MFA session stays MFA).
        await SignInManager.RefreshSignInAsync(_user);
        await Recorder.AccountEventAsync(AuditActions.PasswordChanged, HttpContext.User);
        RedirectManager.RedirectToCurrentPageWithStatus(L["ChangePassword.Success"], HttpContext);
    }

    private sealed class InputModel
    {
        public string OldPassword { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
