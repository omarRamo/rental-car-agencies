@page "/account/forgot-password-confirmation"
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["ForgotConfirmation.Title"]</PageTitle>

<div class="account">
    <div class="card">
        <h1>@L["ForgotConfirmation.Title"]</h1>
        <p role="status">@L["ForgotConfirmation.Message"]</p>
        <p><a href="account/login">@L["BackToLogin"]</a></p>
    </div>
</div>
