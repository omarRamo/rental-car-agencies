@page "/account/invalid-password-reset"
@inject IStringLocalizer<AccountResources> L

<PageTitle>@L["InvalidReset.Title"]</PageTitle>

<div class="account">
    <div class="card">
        <h1>@L["InvalidReset.Title"]</h1>
        <p role="status">@L["InvalidReset.Message"]</p>
        <p><a href="account/login">@L["BackToLogin"]</a></p>
    </div>
</div>
