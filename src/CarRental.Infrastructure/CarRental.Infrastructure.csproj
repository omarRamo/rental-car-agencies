<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adapters: EF Core / SQL Server persistence, ASP.NET Core Identity stores, Hangfire, Azure Blob Storage,
    Azure Communication Services e-mail, Data Protection. Later: Clic to Pay, WhatsApp, AI, TTN, channels.
  -->
  <PropertyGroup>
    <RootNamespace>CarRental.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarRental.Application\CarRental.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Anthropic.Foundry" />
  </ItemGroup>

  <!-- System prompt of the WhatsApp agent (PROMPT.md, annexe B, verbatim) and its technical addendum. -->
  <ItemGroup>
    <EmbeddedResource Include="Messaging\Prompts\*.md" LogicalName="CarRental.Infrastructure.Messaging.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CarRental.Integration.Tests" />
    <!-- The adapters of the WhatsApp agent (Claude client, scripted model) are tested offline there (ADR-0055). -->
    <InternalsVisibleTo Include="CarRental.Application.Tests" />
  </ItemGroup>

</Project>
