<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings used by CI (dotnet test --collect "XPlat Code Coverage" --settings .github/coverlet.runsettings).
  Requires the coverlet.collector package in every test project.
  Only CarRental.* production assemblies are measured; generated code and EF Core migrations are excluded.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[CarRental.*]*</Include>
          <Exclude>[CarRental.*.Tests]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
