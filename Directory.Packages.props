<Project>

  <!--
    Central package management: every PackageReference version lives here.
    Only stable releases. Licenses checked: no commercial/ambiguous licenses
    (MediatR, AutoMapper, FluentAssertions v8+ are deliberately absent).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versions listed here also pin transitive dependencies (used for the security pins below). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Data access -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>

  <!-- Background jobs -->
  <ItemGroup>
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
  </ItemGroup>

  <!-- Azure -->
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
  </ItemGroup>

  <!-- Observability -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>

  <!-- Web UI -->
  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <!--
    WhatsApp AI agent (ADR-0055): the official Anthropic C# SDK (MIT) with its Microsoft Foundry client (MIT), and the
    Microsoft.Extensions.AI abstraction (IChatClient, MIT) at the version the SDK is built against. Exact versions:
    the agent relies on the IChatClient adapter of this SDK release (cache control, usage, refusal, effort).
  -->
  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="13.0.0" />
    <PackageVersion Include="Anthropic.Foundry" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1" />
  </ItemGroup>

  <!-- Excel exports of the reports (ClosedXML: MIT; its dependencies DocumentFormat.OpenXml, ExcelNumberFormat, RBush: MIT). -->
  <ItemGroup>
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Kept on the last 1.x release (Apache-2.0): SixLabors.Fonts 2.0 and later are under the Six Labors Split License. -->
    <PackageVersion Include="SixLabors.Fonts" Version="1.0.1" />
  </ItemGroup>

  <!--
    Documents. QuestPDF under its Community licence (set once at startup): free while the annual gross revenue of the
    agency stays under the threshold of the licence (points-ouverts.md, "QuestPDF"); a paid licence is needed above it.
  -->
  <ItemGroup>
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <!--
    Security pins for vulnerable transitive dependencies (NuGet audit fails the build otherwise).
    Remove a pin once every direct dependency requires a patched version.
  -->
  <ItemGroup>
    <!-- Hangfire.Core depends on Newtonsoft.Json >= 11.0.1 (GHSA-5crp-9r3c-p9vr). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Microsoft.Data.SqlClient 6.1.7 depends on 9.0.11 (CVE-2026-70162, CVE-2026-84008). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Microsoft.AspNetCore.DataProtection 10.0.10 package (via Azure DataProtection extensions) depends on 10.0.10 (CVE-2026-96960). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <!-- xUnit.net v3 on VSTest (MTP disabled): CI uses `dotnet test` VSTest options (trx logger, coverlet collector). -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.5.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <!-- Reads the text of the generated PDF documents (tests only, Apache-2.0). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
