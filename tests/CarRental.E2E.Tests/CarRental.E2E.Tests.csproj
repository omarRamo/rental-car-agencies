<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hosts/inspects the ASP.NET Core app: use the shared framework (also prunes framework-provided packages at restore). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Browser tests: the real app on Kestrel (free port) against Testcontainers SQL/Azurite, driven by Playwright. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CarRental.Web\CarRental.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
